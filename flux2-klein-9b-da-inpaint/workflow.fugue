{
  "fugue": 1,
  "app": {
    "format": 1,
    "title": "Inpaint",
    "description": "Redraws the part of a picture you paint, following a prompt, and keeps the rest as it is (FLUX.2 Klein 9B). Paint the part to change in white.",
    "defaultView": "app",
    "inputs": [
      {
        "role": "image",
        "targets": [
          "load.file"
        ],
        "label": "Picture"
      },
      {
        "role": "mask",
        "targets": [
          "load.mask"
        ],
        "label": "Part to change (paint it white)"
      },
      {
        "role": "prompt",
        "targets": [
          "encode.prompt"
        ],
        "label": "What goes there"
      },
      {
        "role": "seed",
        "targets": [
          "sample.seed"
        ],
        "label": "Seed"
      },
      {
        "name": "steps",
        "targets": [
          "sample.steps"
        ],
        "label": "Steps",
        "min": 1,
        "max": 12,
        "section": "Advanced"
      },
      {
        "name": "width",
        "targets": [
          "resize-image.width",
          "resize-mask.width"
        ],
        "label": "Working width (pixels)",
        "min": 256,
        "max": 2048,
        "section": "Advanced"
      },
      {
        "name": "height",
        "targets": [
          "resize-image.height",
          "resize-mask.height"
        ],
        "label": "Working height (pixels)",
        "min": 256,
        "max": 2048,
        "section": "Advanced"
      }
    ],
    "outputs": [
      {
        "node": "save",
        "label": "Inpainted picture"
      }
    ]
  },
  "graph": {
    "nodes": {
      "decode": {
        "inputs": {
          "latent": {
            "from": "sample.latent"
          }
        },
        "type": "fugue/vae-decode",
        "version": "1.0.0"
      },
      "encode": {
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": "a cozy reading corner with a mustard yellow velvet armchair, tall bookshelves and a floor lamp, soft evening light",
          "reference_size": "exact",
          "references": [
            {
              "from": "resize-image.image"
            }
          ]
        },
        "type": "fugue/text-encode",
        "version": "1.1.0"
      },
      "load": {
        "inputs": {
          "file": "inputs/reading-nook.jpg",
          "mask": "inputs/reading-nook-armchair-mask.png"
        },
        "type": "fugue/load-image",
        "version": "1.1.0"
      },
      "models": {
        "inputs": {
          "diffusion_model": {
            "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6",
            "name": "flux-2-klein-9b-Q8_0.gguf",
            "resource": "fugue/diffusion-model"
          },
          "text_encoder": {
            "hash": "sha256:408b955510e196121c1c375201744783b5c9a43c7956d73fc78df54c66e883d6",
            "name": "qwen3/Qwen3-8B-Q8_0.gguf",
            "resource": "fugue/text-encoder"
          },
          "vae": {
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
            "name": "flux2-vae.safetensors",
            "resource": "fugue/vae"
          }
        },
        "type": "fugue/load-models",
        "version": "1.0.0"
      },
      "preview": {
        "inputs": {
          "value": {
            "from": "decode.image"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "resize-image": {
        "inputs": {
          "fit": "cover",
          "height": 1024,
          "image": {
            "from": "load.image"
          },
          "method": "bicubic",
          "width": 1024
        },
        "type": "fugue/resize",
        "version": "1.0.0"
      },
      "resize-mask": {
        "inputs": {
          "fit": "cover",
          "height": 1024,
          "image": {
            "from": "load.mask"
          },
          "method": "nearest",
          "width": 1024
        },
        "type": "fugue/resize",
        "version": "1.0.0"
      },
      "sample": {
        "inputs": {
          "conditioning": {
            "from": "encode.conditioning"
          },
          "denoise": 1.0,
          "denoise_mode": "schedule_cut",
          "flow_shift": 2.02,
          "guidance": 1,
          "latent": {
            "from": "vae-encode.latent"
          },
          "model": {
            "from": "models.model"
          },
          "sampler": "euler",
          "scheduler": "discrete",
          "seed": 776,
          "steps": 6
        },
        "type": "fugue/sampler",
        "version": "1.4.0"
      },
      "save": {
        "inputs": {
          "image": {
            "from": "decode.image"
          },
          "name": "{date}/{model}_{time}"
        },
        "type": "fugue/save-image",
        "version": "1.1.0"
      },
      "vae-encode": {
        "inputs": {
          "image": {
            "from": "resize-image.image"
          },
          "mask": {
            "from": "resize-mask.image"
          },
          "model": {
            "from": "models.model"
          }
        },
        "type": "fugue/vae-encode",
        "version": "1.1.0"
      }
    }
  },
