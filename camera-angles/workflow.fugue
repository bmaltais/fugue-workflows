     },
     "strength": 1.0
    }
   },
   "enc_front-right": {
    "type": "fugue/text-encode",
    "version": "1.1.0",
    "inputs": {
     "model": {
      "from": "lora1.model"
     },
     "prompt": "<sks> front-right quarter view eye-level shot medium shot",
     "reference_size": "exact",
     "references": [
      {
       "from": "rs.image"
      }
     ]
    }
   },
