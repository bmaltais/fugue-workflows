{
 "fugue": 1,
 "app": {
  "format": 1,
  "title": "Camera Angles",
  "description": "Makes six views of the subject of your picture from different camera positions, and a labelled sheet of all six. The views come from a LoRA trained on 96 camera poses, so the subject and room stay the same and only the camera moves.",
  "defaultView": "app",
  "inputs": [
   {
    "role": "image",
    "name": "picture",
    "targets": [
     "load.file"
    ],
    "label": "Your picture"
   },
   {
    "role": "seed",
    "targets": [
     "sample_front-right.seed",
     "sample_right-side.seed",
     "sample_left-side.seed",
     "sample_back.seed",
     "sample_from-above.seed",
     "sample_close-up.seed"
    ],
    "label": "Seed"
   }
  ],
  "outputs": [
   {
    "node": "save_grid",
    "label": "All views"
   },
   {
    "node": "save_front-right",
    "label": "Front right"
   },
   {
    "node": "save_right-side",
    "label": "Right side"
   },
   {
    "node": "save_left-side",
    "label": "Left side"
   },
   {
    "node": "save_back",
    "label": "Back"
   },
   {
    "node": "save_from-above",
    "label": "From above"
   },
   {
    "node": "save_close-up",
    "label": "Close-up"
   }
  ]
 },
 "graph": {
  "nodes": {
   "models": {
    "type": "fugue/load-models",
    "version": "1.2.0",
