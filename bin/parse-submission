#!/usr/bin/env python3
"""bin/parse-submission --body-file FILE --login LOGIN --issue N --out DIR [--root TEMPLATES_DIR]

Reads the body of a "Submit a template" issue (the form in .github/ISSUE_TEMPLATE/submit-template.yml) and writes one
small file per value into DIR: author, title, description, category, id, url. Each file holds one line of plain text, so a
shell reads it with "$(cat DIR/title)" and never evaluates it. Nothing here is trusted: the issue is written by a stranger.

- The form's headings must each appear once and in order (a heading typed inside a text box would otherwise start a fake section).
- title (at most 80 characters) and description (at most 1000) have their white space collapsed and may hold no control or invisible character.
- category is the id in the parentheses of the chosen option, and must be in categories.json.
- url is the first https://github.com/user-attachments/files/<number>/<name>.zip link of the package section.
- id is a slug of the title (lowercase letters, digits and dashes). It must not exist in --root (default: this repo).
Exit 1 with a plain message on stderr when the issue cannot be used. Python 3 standard library only.
"""
import argparse
import os
import re
import sys
import unicodedata

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.dont_write_bytecode = True
import _contrib as c  # noqa: E402

HEADINGS = ("The package", "Title", "Description", "Category", "Models used", "Based on someone else's work?", "Confirm")
REQUIRED = ("The package", "Title", "Description", "Category")
ATTACHMENT = re.compile(r"https://github\.com/user-attachments/files/[0-9]+/[A-Za-z0-9._%+-]+\.zip(?![A-Za-z0-9._%+-])", re.IGNORECASE)
LOGIN = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$")
NO_RESPONSE = "_No response_"


def fail(message):
    print(f"error: {c.safe(message)}", file=sys.stderr)
    sys.exit(1)


def sections(body):
    """{heading: text} of the form's headings; each must appear once, in the form's order."""
    found = [(m.group(1).strip(), m.start(), m.end()) for m in re.finditer(r"(?m)^### (.*?)\s*$", body)]
    known = [f for f in found if f[0] in HEADINGS]
    names = [f[0] for f in known]
    if len(set(names)) != len(names):
        fail("the issue repeats a heading of the form (### " + c.safe(next(n for n in names if names.count(n) > 1)) + "): "
             "a heading typed inside a text box is not allowed. Edit the issue and remove it.")
    if names != [h for h in HEADINGS if h in names]:
        fail("the headings of the form are not in their order: open a new issue from the form instead of editing the body by hand.")
    out = {}
    for i, (name, _start, end) in enumerate(known):
        nxt = known[i + 1][1] if i + 1 < len(known) else len(body)
        text = body[end:nxt].strip()
        out[name] = "" if text == NO_RESPONSE else text
    for need in REQUIRED:
        if not out.get(need):
            fail(f"the form's '{need}' is empty.")
    return out


def one_line(text, what, limit):
    text = re.sub(r"\s+", " ", text).strip()
    if c.DANGEROUS.search(text):
        fail(f"the {what} has a control or invisible character.")
    if len(text) > limit:
        fail(f"the {what} is {len(text)} characters (at most {limit}).")
    return text


def slug(title, issue):
    text = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
    text = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:48].strip("-")
    if not text or text == "bin":
        text = f"template-{issue}"
    return text


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--body-file", required=True)
    ap.add_argument("--login", required=True)
    ap.add_argument("--issue", type=int, required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--root", default=c.ROOT)
    args = ap.parse_args()
    if not LOGIN.match(args.login) or args.issue < 1:
        fail("the issue's author is not a plain GitHub login.")
    with open(args.body_file, encoding="utf-8", errors="replace") as f:
        body = f.read().replace("\r\n", "\n").replace("\r", "\n")
    form = sections(body)
    title = one_line(form["Title"], "title", 80)
    description = one_line(form["Description"], "description", 1000)
    match = re.search(r"\(([a-z][a-z0-9-]*)\)\s*$", form["Category"])
    ids = c.categories()
    if not match or match.group(1) not in ids:
        fail(f"the category is not one of: {', '.join(ids)}.")
    url = ATTACHMENT.search(form["The package"])
    if not url:
        fail("the package section has no attached .zip (a https://github.com/user-attachments/files/... link). Rename the .fuguepack to .zip and drag it in.")
    if "- [ ]" in form.get("Confirm", ""):
        fail("the Confirm boxes are not all ticked.")
    template_id = slug(title, args.issue)
    if os.path.lexists(os.path.join(args.root, template_id)):
        fail(f"a template with the id {template_id} exists already. Change the title so its slug is different (the maintainer can still rename the folder in the pull request).")
    os.makedirs(args.out, exist_ok=True)
    values = {"author": args.login, "title": title, "description": description, "category": match.group(1), "id": template_id, "url": url.group(0)}
    for key, value in values.items():
        with open(os.path.join(args.out, key), "w", encoding="utf-8") as f:
            f.write(value + "\n")
    print(f"id {template_id}, category {match.group(1)}, author {args.login}, title {c.safe(title)!r}")


if __name__ == "__main__":
    main()
