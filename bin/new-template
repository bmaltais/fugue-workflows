#!/usr/bin/env python3
"""bin/new-template <id> [--from my.fugue] [--category C] [--title T] [--author A [--issue N]]

Starts a template folder. With --from, the saved workflow is copied in as workflow.fugue and the pictures
its Load Image nodes name (an absolute path, or a path beside the file) go to <id>/inputs/ with the
nodes pointed at `inputs/<name>`. Without it you get template.json and put workflow.fugue in yourself.
For a workflow you exported with File > Export for sharing..., use bin/import-fuguepack.
"""
import argparse
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.dont_write_bytecode = True
import _contrib as c  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description="Start a template folder.")
    ap.add_argument("id")
    ap.add_argument("--from", dest="source", metavar="FILE.fugue")
    ap.add_argument("--category")
    ap.add_argument("--title")
    ap.add_argument("--author", help="marks the template community, by this GitHub login or name")
    ap.add_argument("--issue", type=int, help="the issue it came from, if any (with --author)")
    args = ap.parse_args()

    folder = c.check_id(args.id)
    c.check_category(args.category)
    community = None
    if args.author or args.issue is not None:
        if not args.author or c.DANGEROUS.search(args.author) or not args.author.strip() or len(args.author) > 80 or (args.issue is not None and args.issue < 1):
            c.die("--author is plain text (at most 80 characters), required with --issue, and --issue a positive number.")
        community = {"author": args.author.strip()}
        if args.issue is not None:
            community["issue"] = args.issue
    about = {"community": community} if community else None
    title = args.title or args.id.replace("-", " ").capitalize()
    description = "TODO: what it makes, and what it needs, in two sentences"
    workflow, notes, extra = None, [], []
    if args.source:
        try:
            workflow = c.json_load(args.source)
        except (OSError, ValueError) as e:
            c.die(f"cannot read {c.safe(args.source)}: {c.safe(e)}")
        if not isinstance(workflow, dict):
            c.die(f"{c.safe(args.source)} is not a Fugue workflow.")
        base = os.path.dirname(os.path.abspath(args.source))
        os.makedirs(folder)
        try:
            def find(value):
                path = os.path.expanduser(value)
                path = path if os.path.isabs(path) else os.path.join(base, path)
                return path if os.path.isfile(path) else None

            notes, missing = c.gather_inputs(workflow, folder, find, show_real=True)
            extra = [f"not found, put it in inputs/ yourself: {m}" for m in missing]
            extra += c.finish_paths(workflow)
            block = workflow.get("app") if isinstance(workflow.get("app"), dict) else {}
            title = args.title or c.text_of(block.get("title"), title)
            description = c.text_of(block.get("description"), description)
            c.write_template(folder, workflow, title, description, args.category, about)
            items = c.todo(folder, extra)
        except BaseException:
            shutil.rmtree(folder, ignore_errors=True)
            raise
    else:
        os.makedirs(folder)
        c.write_template(folder, {}, title, description, args.category, about)
        os.remove(os.path.join(folder, "workflow.fugue"))
        extra.append("workflow.fugue: put your saved workflow here as workflow.fugue, or start again with --from")
        items = c.todo(folder, extra)
    for note in notes:
        print(f"  copied {note}")
    c.report(args.id, items)


if __name__ == "__main__":
    main()
