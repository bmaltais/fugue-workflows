#!/usr/bin/env python3
"""bin/import-fuguepack <file.fuguepack> <id> [--category C] [--title T]

Turns a package made with File > Export for sharing... (a .fuguepack or .fugueapp, a zip) into the template folder
<id>/: workflow.fugue, inputs/, packs/ (without tests), a template.json skeleton and, when the package has
a result picture, the preview. Prints what is still missing. The package is untrusted: names outside the folder,
links and oversized entries are refused. Python 3 standard library only.
"""
import argparse
import json
import os
import posixpath
import shutil
import stat
import sys
import tempfile
import zipfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.dont_write_bytecode = True
import _contrib as c  # noqa: E402

MAX_ENTRIES = 5000
MAX_TOTAL = 1 << 30  # 1 GB unpacked; a template is small


def unzip_safely(archive, dest):
    """Unpack into dest after checking every entry. Returns the single top folder's name."""
    infos = archive.infolist()
    if len(infos) > MAX_ENTRIES:
        c.die(f"the package has {len(infos)} entries (at most {MAX_ENTRIES}).")
    if sum(i.file_size for i in infos) > MAX_TOTAL:
        c.die("the package is over 1 GB unpacked.")
    tops = set()
    for info in infos:
        name = info.filename
        parts = name.split("/")
        if name.startswith("/") or "\\" in name or ":" in name or ".." in parts or "" in parts[:-1]:
            c.die(f"the package has an entry outside its folder: {name!r}. Refused.")
        if stat.S_ISLNK(info.external_attr >> 16):
            c.die(f"the package holds a link: {name!r}. Refused.")
        if any(p.startswith(".") for p in parts if p):
            continue  # dot files are never taken (git and the feed skip them too)
        tops.add(parts[0])
    if len(tops) != 1:
        c.die("a Fugue package holds one folder; this one does not look like one.")
    top = tops.pop()
    for info in infos:
        parts = [p for p in info.filename.split("/") if p]
        if not parts or any(p.startswith(".") for p in parts):
            continue
        target = os.path.join(dest, *parts)
        if os.path.commonpath([dest, os.path.realpath(os.path.dirname(target))]) != dest:
            c.die(f"the package has an entry outside its folder: {info.filename!r}. Refused.")
        if info.is_dir():
            os.makedirs(target, exist_ok=True)
            continue
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with archive.open(info) as src, open(target, "wb") as out:
            shutil.copyfileobj(src, out)
        if info.external_attr >> 16 & 0o111:
            os.chmod(target, 0o755)  # a pack's run.sh
    return top


def main():
    ap = argparse.ArgumentParser(description="Make a template folder from a .fuguepack.")
    ap.add_argument("package")
    ap.add_argument("id")
    ap.add_argument("--category")
    ap.add_argument("--title")
    args = ap.parse_args()

    folder = c.check_id(args.id)
    c.check_category(args.category)
    if not zipfile.is_zipfile(args.package):
        c.die(f"{args.package} is not a Fugue package (it is not a zip file).")

    scratch = os.path.realpath(tempfile.mkdtemp(prefix="import-fuguepack-"))
    try:
        with zipfile.ZipFile(args.package) as archive:
            top = unzip_safely(archive, scratch)
        source = os.path.join(scratch, top)
        flow_path = os.path.join(source, "workflow.fugue")
        if not os.path.isfile(flow_path):
            c.die(f"no {top}/workflow.fugue in the package.")
        with open(flow_path, encoding="utf-8") as f:
            workflow = json.load(f)
        try:
            with open(os.path.join(source, "template.json"), encoding="utf-8") as f:
                packaged = json.load(f)
        except (OSError, ValueError):
            packaged = {}
        block = workflow.get("app") if isinstance(workflow.get("app"), dict) else {}

        os.makedirs(folder)
        try:
            def find(value):
                path = os.path.join(source, *value.split("/"))
                return path if os.path.commonpath([source, os.path.realpath(path)]) == source and os.path.isfile(path) else None

            notes, missing = c.gather_inputs(workflow, folder, find)
            title = args.title or block.get("title") or (packaged.get("title") if packaged.get("title") != "workflow" else None) or args.id
            description = block.get("description") or packaged.get("description") or "TODO: what it makes, and what it needs, in two sentences"
            c.write_template(folder, workflow, title, description, args.category)

            extra = [f"not in the package, put it in inputs/ yourself: {m}" for m in missing]
            carried = os.path.join(source, "packs")
            if os.path.isdir(carried):
                for pack in sorted(os.listdir(carried)):
                    src = os.path.join(carried, pack)
                    if os.path.isdir(src):
                        shutil.copytree(src, os.path.join(folder, "packs", pack),
                                        ignore=shutil.ignore_patterns("tests", ".*", "__pycache__", "venv", "node_modules"))
                        notes.append(f"packs/{pack}/ (without tests); check requires.packs has the same version")
            picture = next((os.path.join(source, n) for n in os.listdir(source) if n.startswith("preview.")), None)
            if picture:
                line = c.make_preview(folder, picture)
                if line:
                    extra.append(line)
            else:
                extra.append("preview.webp: the package has no result picture. Run the workflow once before exporting, or make a picture "
                             "of what it makes, about 768 px wide, at most 300 KB")
        except BaseException:
            shutil.rmtree(folder, ignore_errors=True)
            raise
        for note in notes:
            print(f"  put in {note}")
        c.report(args.id, c.todo(folder, extra))
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    main()
