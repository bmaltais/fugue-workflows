#!/usr/bin/env python3
"""bin/test-import: hostile and odd packages against bin/import-fuguepack and bin/new-template. No Fugue needed.

Builds each package in a temporary folder, imports it under a throwaway id and checks the result. The id folders
it makes in the repo are removed at the end.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import zipfile

sys.dont_write_bytecode = True
BIN = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(BIN)
PNG = b"\x89PNG\r\n\x1a\n" + b"\0" * 32
JPG = b"\xff\xd8\xff\xe0" + b"\0" * 32
failures = []
made = []


def flow(extra=None, file="inputs/a.png"):
    doc = {"fugue": 1, "graph": {"nodes": {"load": {"type": "fugue/load-image", "version": "1.0.0", "inputs": {"file": file}}}}}
    doc.update(extra or {})
    return json.dumps(doc)


def zip_of(path, entries):
    with zipfile.ZipFile(path, "w") as z:
        for name, data in entries.items():
            info = zipfile.ZipInfo(name)
            if isinstance(data, tuple):
                info.external_attr = data[1] << 16
                data = data[0]
            z.writestr(info, data)


def run(*args):
    done = subprocess.run([sys.executable, *args], capture_output=True, text=True, cwd=ROOT)
    return done.returncode, done.stdout + done.stderr


def expect(name, ok, detail=""):
    print(("ok   " if ok else "FAIL ") + name)
    if not ok:
        failures.append(name)
        print("     " + detail.replace("\n", "\n     ")[:600])


def importing(tmp, name, entries, *flags, id_="zz-test-import"):
    pkg = os.path.join(tmp, name)
    zip_of(pkg, entries)
    made.append(id_)
    shutil.rmtree(os.path.join(ROOT, id_), ignore_errors=True)
    code, out = run(os.path.join(BIN, "import-fuguepack"), pkg, id_, "--category", "edit", *flags)
    return code, out, os.path.join(ROOT, id_)


with tempfile.TemporaryDirectory() as tmp:
    base = {"p/workflow.fugue": flow(), "p/template.json": '{"title": "workflow"}', "p/inputs/a.png": PNG}

    code, out, folder = importing(tmp, "ok.fuguepack", {**base, "p/preview.png": PNG})
    expect("a normal package imports", code == 0 and os.path.isfile(folder + "/inputs/a.png") and os.path.isfile(folder + "/preview.png"), out)

    code, out, folder = importing(tmp, "mvg.fuguepack", {**base, "p/preview.mvg": b"push graphic-context\nimage over 0,0 0,0 'text:@/etc/hostname'\n"})
    expect("an .mvg preview is not copied or converted", code == 0 and not [f for f in os.listdir(folder) if f.startswith("preview")] and "ImageMagick" in out, out)

    code, out, folder = importing(tmp, "fake.fuguepack", {**base, "p/preview.png": b"push graphic-context\n"})
    expect("a .png that is not a PNG is not copied", code == 0 and not os.path.exists(folder + "/preview.png"), out)

    code, out, folder = importing(tmp, "big.fuguepack", {**base, "p/preview.png": PNG + b"\0" * (301 * 1024)})
    expect("a preview over 300 KB is not copied", code == 0 and not os.path.exists(folder + "/preview.png"), out)

    code, out, folder = importing(tmp, "ctl.fuguepack", {**base, "p/workflow.fugue": flow(file="inputs/\x1b]52;c;QUJD\x07‮.png"), "p/inputs/\x1b]52;c;QUJD\x07‮.png": PNG})
    expect("control characters in names are never printed raw", code == 0 and "\x1b" not in out and "‮" not in out and "\\x1b" in out, repr(out))

    code, out, folder = importing(tmp, "ctl2.fuguepack", {**base, "p/template.json": json.dumps({"title": "x‮\x85y"})})
    text = open(folder + "/template.json", encoding="utf-8").read() if os.path.isdir(folder) else ""
    expect("bidi and C1 characters in written JSON are escaped", code == 0 and "‮" not in text and "\x85" not in text, text)

    code, out, folder = importing(tmp, "dirname.fuguepack", {"\x1b]52;c;QUJD\x07/workflow.fugue": flow(), "\x1b]52;c;QUJD\x07/x": "1"})
    expect("a hostile top folder name is not printed raw", "\x1b" not in out, repr(out))

    code, out, folder = importing(tmp, "packs.fuguepack", {**base, "p/packs/my.pack/pack.json": "{}", "p/packs/my.pack/run.sh": (b"#!/bin/sh\n", 0o100755), "p/packs/my.pack/bin": (b"\0\1\2", 0o100755),
                                                          "p/packs/my.pack/n/node.json": '{"runtime": {"entry": "./go.sh"}}', "p/packs/my.pack/n/go.sh": (b"#!/bin/sh\n", 0o100755)})
    expect("a package with packs is refused", code != 0 and "--allow-packs" in out and not os.path.exists(folder), out)
    code, out, folder = importing(tmp, "packs.fuguepack", {**base, "p/packs/my.pack/pack.json": "{}", "p/packs/my.pack/run.sh": (b"#!/bin/sh\n", 0o100755), "p/packs/my.pack/bin": (b"\0\1\2", 0o100755),
                                                          "p/packs/my.pack/tests/t.py": "x", "p/packs/my.pack/n/node.json": '{"runtime": {"entry": "./go.sh"}}', "p/packs/my.pack/n/go.sh": (b"#!/bin/sh\n", 0o100755)}, "--allow-packs")
    pack = folder + "/packs/my.pack"
    expect("--allow-packs lists files, keeps only the named run script executable, drops tests",
           code == 0 and "NOT TEXT" in out and os.access(pack + "/n/go.sh", os.X_OK) and not os.access(pack + "/run.sh", os.X_OK)
           and not os.access(pack + "/bin", os.X_OK) and not os.path.exists(pack + "/tests"), out)

    code, out, folder = importing(tmp, "mac.fuguepack", {**base, "__MACOSX/p/._workflow.fugue": "junk", "p/.DS_Store": "junk"})
    expect("__MACOSX and dot entries are ignored", code == 0 and os.path.isfile(folder + "/workflow.fugue"), out)

    code, out, folder = importing(tmp, "flat.fuguepack", {"workflow.fugue": flow(), "template.json": '{"title": "Flat"}', "inputs/a.png": PNG})
    expect("a flat package imports", code == 0 and os.path.isfile(folder + "/inputs/a.png"), out)

    inner = os.path.join(tmp, "inner.fuguepack")
    zip_of(inner, base)
    code, out, folder = importing(tmp, "nested.zip", {"inner.fuguepack": open(inner, "rb").read()})
    expect("a package inside a zip imports", code == 0 and os.path.isfile(folder + "/inputs/a.png"), out)

    for label, requires in (("a list", []), ("a model that is not an object", {"models": [1, "x"]}), ("an unhashable hash", {"models": [{"hash": ["x"], "resource": "r"}]})):
        code, out, folder = importing(tmp, "req.fuguepack", {**base, "p/workflow.fugue": flow({"requires": requires})})
        expect(f"malformed requires ({label}) does not crash", code == 0 and "Traceback" not in out, out)

    code, out, folder = importing(tmp, "dots.fuguepack", {**base, "p/../../x": "no"})
    expect("a ../ entry is refused", code != 0 and not os.path.exists(folder), out)

    code, out, folder = importing(tmp, "link.fuguepack", {**base, "p/l": (b"/etc/passwd", 0o120777)})
    expect("a link is refused", code != 0 and not os.path.exists(folder), out)

    code, out, folder = importing(tmp, "case.fuguepack", {**base, "p/inputs/A.png": PNG})
    expect("names that differ only by case are refused", code != 0 and not os.path.exists(folder), out)

    code, out, folder = importing(tmp, "nfc.fuguepack", {**base, "p/inputs/é.png": PNG, "p/inputs/é.png": PNG})
    expect("names that differ only by Unicode form are refused", code != 0 and not os.path.exists(folder), out)

    code, out, folder = importing(tmp, "path.fuguepack", {**base, "p/workflow.fugue": flow({"x": {"note": "/home/someone/secret.txt"}}, file="/home/someone/cat.png")})
    text = open(folder + "/workflow.fugue", encoding="utf-8").read() if os.path.isdir(folder) else ""
    expect("local paths are cut to bare names, with a note", code == 0 and "/home/someone" not in text and "bare name" in out, out + text)

    code, out, folder = importing(tmp, "notpng.fuguepack", {**base, "p/inputs/a.png": b"not a picture at all, an svg or mvg maybe"})
    expect("a sample that is not a picture is not copied", code == 0 and not os.path.exists(folder + "/inputs/a.png"), out)

    twice = {"p/workflow.fugue": json.dumps({"graph": {"nodes": {n: {"type": "fugue/load-image", "inputs": {"file": "inputs/a.png"}} for n in ("l1", "l2")}}}), "p/inputs/a.png": PNG}
    code, out, folder = importing(tmp, "twice.fuguepack", twice)
    expect("a file two nodes name is copied once", code == 0 and os.listdir(folder + "/inputs") == ["a.png"], out)

    # new-template --from: absolute path, and a file that is not a picture
    pic = os.path.join(tmp, "cat.jpg")
    open(pic, "wb").write(JPG)
    fake = os.path.join(tmp, "fake.png")
    open(fake, "w").write("not a picture")
    mine = os.path.join(tmp, "my.fugue")
    open(mine, "w").write(json.dumps({"graph": {"nodes": {"a": {"type": "fugue/load-image", "inputs": {"file": pic}}, "b": {"type": "fugue/load-image", "inputs": {"file": fake}}}}}))
    made.append("zz-test-new")
    code, out = run(os.path.join(BIN, "new-template"), "zz-test-new", "--from", mine, "--category", "edit")
    text = open(ROOT + "/zz-test-new/workflow.fugue").read() if code == 0 else ""
    expect("new-template copies a real picture, prints source -> destination, cuts the rest to a bare name",
           code == 0 and os.path.isfile(ROOT + "/zz-test-new/inputs/cat.jpg") and "-> inputs/cat.jpg" in out and not os.path.exists(ROOT + "/zz-test-new/inputs/fake.png") and tmp not in text, out + text)

for id_ in set(made):
    shutil.rmtree(os.path.join(ROOT, id_), ignore_errors=True)
print(f"{len(failures)} failed" if failures else "all passed")
sys.exit(1 if failures else 0)
