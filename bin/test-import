#!/usr/bin/env python3
"""bin/test-import: hostile and odd packages against bin/import-fuguepack, bin/new-template and bin/check. No Fugue needed.

Builds each package in a temporary folder and imports it into a scratch templates folder ($FUGUE_TEMPLATES_TEST_ROOT points
the scripts at it), so nothing is written into this repo. Every file an import writes must parse, and bin/check-all must pass on it.
"""
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import zipfile
import zlib

sys.dont_write_bytecode = True
BIN = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(BIN)
failures = []


def chunk(kind, data):
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))


def png(extra=0, width=1):
    body = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, 1, 8, 0, 0, 0, 0))
    if extra:
        body += chunk(b"tEXt", b"k\0" + b"v" * extra)
    return body + chunk(b"IDAT", zlib.compress(b"\0\0")) + chunk(b"IEND", b"")


PNG = png()
SOF = b"\xff\xc0\x00\x11\x08\x00\x01\x00\x01\x03\x01\x11\x00\x02\x11\x00\x03\x11\x00"
SOS = b"\xff\xda\x00\x0c\x03\x01\x00\x02\x00\x03\x00\x00\x3f\x00"
JPG = b"\xff\xd8" + SOF + SOS + b"\x12\x34" + b"\xff\xd9"
WEBP = b"RIFF" + struct.pack("<I", 18) + b"WEBPVP8L" + struct.pack("<I", 5) + b"/\0\0\0\0" + b"\0"
ABOUT = json.dumps({"title": "A title", "description": "What it makes."})


def flow(extra=None, file="inputs/a.png", prompt=None):
    nodes = {"load": {"type": "fugue/load-image", "version": "1.0.0", "inputs": {"file": file}}}
    if prompt:
        nodes["text"] = {"type": "fugue/text", "inputs": {"text": prompt}}
    doc = {"fugue": 1, "graph": {"nodes": nodes}}
    doc.update(extra or {})
    return json.dumps(doc)


def zip_of(path, entries):
    with zipfile.ZipFile(path, "w") as z:
        for name, data in entries.items():
            info = zipfile.ZipInfo(name)
            if isinstance(data, tuple):
                info.external_attr = data[1] << 16
                data = data[0]
            z.writestr(info, data)


def run(script, *args, env=None):
    cmd = ["bash", os.path.join(BIN, script)] if script == "check-all" else [sys.executable, os.path.join(BIN, script)]
    done = subprocess.run([*cmd, *args], capture_output=True, text=True, env={**os.environ, **(env or {})})
    return done.returncode, done.stdout + done.stderr


def expect(name, ok, detail=""):
    print(("ok   " if ok else "FAIL ") + name)
    if not ok:
        failures.append(name)
        print("     " + detail.replace("\n", "\n     ")[:700])


with tempfile.TemporaryDirectory() as tmp:
    root = os.path.join(tmp, "templates")
    os.makedirs(root)
    shutil.copy(os.path.join(REPO, "categories.json"), root)
    env = {"FUGUE_TEMPLATES_TEST_ROOT": root, "PYTHONDONTWRITEBYTECODE": "1"}
    ID = "zz-test-import"

    def importing(name, entries, *flags, author=True):
        pkg = os.path.join(tmp, name)
        zip_of(pkg, entries)
        shutil.rmtree(os.path.join(root, ID), ignore_errors=True)
        extra = ["--author", "someone", "--issue", "12"] if author is True else ["--author", "someone"] if author == "noissue" else []
        code, out = run("import-fuguepack", pkg, ID, "--category", "edit", *extra, *flags, env=env)
        folder = os.path.join(root, ID)
        if code == 0:  # what an import writes must parse, and never says "unreadable"
            for f in ("workflow.fugue", "template.json"):
                try:
                    json.load(open(os.path.join(folder, f), encoding="utf-8"))
                except (OSError, ValueError) as e:
                    expect(f"{name}: {f} parses", False, str(e))
            if "unreadable" in out:
                expect(f"{name}: no 'unreadable' in the report", False, out)
        return code, out, folder

    base = {"p/workflow.fugue": flow(), "p/template.json": ABOUT, "p/inputs/a.png": PNG}

    code, out, folder = importing("ok.fuguepack", {**base, "p/preview.png": PNG})
    about = json.load(open(folder + "/template.json")) if code == 0 else {}
    expect("a normal package imports, marked community", code == 0 and os.path.isfile(folder + "/inputs/a.png")
           and about.get("community") == {"author": "someone", "issue": 12}, out)
    code2, out2 = run("check-all", env=env)
    expect("bin/check-all passes on an imported folder", code2 == 0, out2)
    code, out, folder = importing("noissue.fuguepack", {**base, "p/preview.png": PNG}, author="noissue")
    expect("--issue is optional", code == 0 and json.load(open(folder + "/template.json"))["community"] == {"author": "someone"}, out)
    code, out = run("check-all", env=env)
    expect("a community template with no issue passes bin/check-all", code == 0, out)
    shutil.rmtree(folder)
    code, out = run("import-fuguepack", os.path.join(tmp, "ok.fuguepack"), "zz-other", "--category", "edit", env=env)
    expect("--author is required", code != 0 and "--author" in out and not os.path.exists(os.path.join(root, "zz-other")), out)

    code, out, folder = importing("mvg.fuguepack", {**base, "p/preview.mvg": b"push graphic-context\nimage over 0,0 0,0 'text:@/etc/hostname'\n"})
    expect("an .mvg preview is not copied or converted", code == 0 and not [f for f in os.listdir(folder) if f.startswith("preview")] and "ImageMagick" in out, out)

    code, out, folder = importing("fake.fuguepack", {**base, "p/preview.png": b"push graphic-context\n"})
    expect("a .png that is not a PNG is not copied", code == 0 and not os.path.exists(folder + "/preview.png"), out)

    code, out, folder = importing("big.fuguepack", {**base, "p/preview.png": png(extra=301 * 1024)})
    expect("a preview over 300 KB is not copied", code == 0 and not os.path.exists(folder + "/preview.png"), out)

    for label, data in (("a PNG with no IEND", PNG[:-12]), ("a PNG of 20000 px", png(width=20000)), ("a JPEG without its end marker", JPG[:-2]),
                        ("a WebP with a wrong RIFF size", WEBP[:4] + struct.pack("<I", 99) + WEBP[8:])):
        code, out, folder = importing("bad.fuguepack", {**base, "p/preview.png": data, "p/preview.jpg": data} if False else {**base, "p/preview." + ("webp" if data[:4] == b"RIFF" else "jpg" if data[:2] == b"\xff\xd8" else "png"): data})
        expect(f"{label} is not copied as a preview", code == 0 and not [f for f in os.listdir(folder) if f.startswith("preview")], out)

    code, out, folder = importing("ext.fuguepack", {**base, "p/workflow.fugue": flow(file="inputs/pic.jpg"), "p/inputs/pic.jpg": PNG})
    expect("a sample is named by its bytes, not its extension", code == 0 and os.path.isfile(folder + "/inputs/pic.png") and "inputs/pic.png" in open(folder + "/workflow.fugue").read(), out)

    osc = "\x1b]52;c;QUJD\x07\u202e\u200b\U000e0041"
    raw = "\x1b\x07\u202e\u200b\U000e0041"
    code, out, folder = importing("ctl.fuguepack", {**base, "p/workflow.fugue": flow(file=f"inputs/{osc}.png"), f"p/inputs/{osc}.png": PNG})
    expect("control, bidi, zero-width and tag characters in names are never printed raw", code == 0 and not any(ch in out for ch in raw) and "\\x1b" in out, repr(out))

    code, out, folder = importing("ctl2.fuguepack", {**base, "p/template.json": json.dumps({"title": "x\u202e\x85\u200by", "description": "d\U000e0041"})})
    text = open(folder + "/template.json", encoding="utf-8").read() if code == 0 else ""
    expect("bidi, C1, zero-width and tag characters in written JSON are escaped", code == 0 and not any(ch in text for ch in "\u202e\x85\u200b\U000e0041"), text)

    code, out, folder = importing("dirname.fuguepack", {f"{osc}/workflow.fugue": flow(), f"{osc}/x": "1"})
    expect("a hostile top folder name is not printed raw", not any(ch in out for ch in raw), repr(out))

    packs = {**base, "p/packs/my.pack/pack.json": "{}", "p/packs/my.pack/run.sh": (b"#!/bin/sh\n", 0o100755), "p/packs/my.pack/bin": (b"\0\1\2", 0o100755),
             "p/packs/my.pack/tests/t.py": "x", "p/packs/my.pack/n/node.json": '{"runtime": {"entry": "./go.sh"}}', "p/packs/my.pack/n/go.sh": (b"#!/bin/sh\n", 0o100755)}
    code, out, folder = importing("packs.fuguepack", packs)
    expect("a community import of a package with packs is refused, and the flag is not suggested", code != 0 and "built-in nodes only" in out and "own-with-packs" not in out and not os.path.exists(folder), out)
    code, out, folder = importing("packs.fuguepack", packs, "--own-with-packs")
    expect("--own-with-packs together with --author is refused", code != 0 and "cannot be combined" in out and not os.path.exists(folder), out)
    code, out, folder = importing("packs.fuguepack", packs, "--own-with-packs", author=False)
    pack = folder + "/packs/my.pack"
    expect("--own-with-packs lists files, keeps only the named run script executable, drops tests, marks nothing community",
           code == 0 and "NOT TEXT" in out and os.access(pack + "/n/go.sh", os.X_OK) and not os.access(pack + "/run.sh", os.X_OK)
           and not os.access(pack + "/bin", os.X_OK) and not os.path.exists(pack + "/tests") and "community" not in json.load(open(folder + "/template.json")), out)

    code, out, folder = importing("mac.fuguepack", {**base, "__MACOSX/p/._workflow.fugue": "junk", "p/.DS_Store": "junk"})
    expect("__MACOSX and dot entries are ignored", code == 0 and os.path.isfile(folder + "/workflow.fugue"), out)

    code, out, folder = importing("flat.fuguepack", {"workflow.fugue": flow(), "template.json": ABOUT, "inputs/a.png": PNG})
    expect("a flat package imports", code == 0 and os.path.isfile(folder + "/inputs/a.png"), out)

    inner = os.path.join(tmp, "inner.fuguepack")
    zip_of(inner, base)
    code, out, folder = importing("nested.zip", {"inner.fuguepack": open(inner, "rb").read()})
    expect("a package inside a zip imports", code == 0 and os.path.isfile(folder + "/inputs/a.png"), out)

    for label, requires in (("a list", []), ("a model that is not an object", {"models": [1, "x"]}), ("an unhashable hash", {"models": [{"hash": ["x"], "resource": "r"}]})):
        code, out, folder = importing("req.fuguepack", {**base, "p/workflow.fugue": flow({"requires": requires})})
        expect(f"malformed requires ({label}) does not crash", code == 0 and "Traceback" not in out, out)

    code, out, folder = importing("dots.fuguepack", {**base, "p/../../x": "no"})
    expect("a ../ entry is refused", code != 0 and not os.path.exists(folder), out)
    code, out, folder = importing("link.fuguepack", {**base, "p/l": (b"/etc/passwd", 0o120777)})
    expect("a link is refused", code != 0 and not os.path.exists(folder), out)
    code, out, folder = importing("case.fuguepack", {**base, "p/inputs/A.png": PNG})
    expect("names that differ only by case are refused", code != 0 and not os.path.exists(folder), out)
    code, out, folder = importing("nfc.fuguepack", {**base, "p/inputs/\u00e9.png": PNG, "p/inputs/e\u0301.png": PNG})
    expect("names that differ only by Unicode form are refused", code != 0 and not os.path.exists(folder), out)
    code, out, folder = importing("dircase.fuguepack", {**base, "p/packs/x/A/f": "1", "p/packs/x/a/g": "2"})
    expect("folders that differ only by case are refused", code != 0 and not os.path.exists(folder), out)
    code, out, folder = importing("filedir.fuguepack", {**base, "p/inputs/a.png/x": "1"})
    expect("a name that is both a file and a folder is refused", code != 0 and not os.path.exists(folder), out)

    code, out, folder = importing("path.fuguepack", {**base, "p/workflow.fugue": flow(file="/home/someone/cat.png", prompt="/imagine a cat in ~/art")})
    text = open(folder + "/workflow.fugue", encoding="utf-8").read() if code == 0 else ""
    expect("a local file path is cut to its bare name; a prompt that starts with / is left alone",
           code == 0 and "/home/someone" not in text and "bare name" in out and "/imagine a cat" in text, out + text)
    code, out, folder = importing("fileurl.fuguepack", {**base, "p/workflow.fugue": flow(file="file:///home/x/a.png")})
    expect("a file:// path is cut too", code == 0 and "file:" not in open(folder + "/workflow.fugue").read(), out)

    code, out, folder = importing("notpng.fuguepack", {**base, "p/inputs/a.png": b"not a picture at all, an svg or mvg maybe"})
    expect("a sample that is not a picture is not copied", code == 0 and not os.path.exists(folder + "/inputs/a.png"), out)

    twice = {"p/workflow.fugue": json.dumps({"graph": {"nodes": {n: {"type": "fugue/load-image", "inputs": {"file": "inputs/a.png"}} for n in ("l1", "l2")}}}), "p/inputs/a.png": PNG}
    code, out, folder = importing("twice.fuguepack", twice)
    expect("a file two nodes name is copied once", code == 0 and os.listdir(folder + "/inputs") == ["a.png"], out)

    shutil.rmtree(os.path.join(root, ID), ignore_errors=True)

    # bin/check: community templates use built-in nodes only; a hostile model name is not printed raw
    def checked(template, flowdoc, *flags):
        folder = os.path.join(root, "zz-check")
        shutil.rmtree(folder, ignore_errors=True)
        os.makedirs(folder)
        json.dump(template, open(folder + "/template.json", "w"))
        json.dump(flowdoc, open(folder + "/workflow.fugue", "w"))
        open(folder + "/preview.png", "wb").write(PNG)
        result = run("check", *flags, env=env)
        shutil.rmtree(folder)
        return result

    about = {"title": "t", "description": "d", "category": "edit", "community": {"author": "a", "issue": 3}}
    ok = {"fugue": 1, "graph": {"nodes": {"a": {"type": "fugue/text", "inputs": {}}}}}
    code, out = checked(about, ok)
    expect("a community template of built-in nodes passes bin/check", code == 0, out)
    code, out = checked(about, {"fugue": 1, "graph": {"nodes": {"a": {"type": "io.example.pack/thing", "inputs": {}}}}})
    expect("a community template with a pack node fails bin/check", code != 0 and "built-in" in out, out)
    nodes = os.path.join(tmp, "nodes.json")
    json.dump({"data": {"nodes": [{"id": "fugue/text"}]}}, open(nodes, "w"))
    code, out = checked(about, {"fugue": 1, "graph": {"nodes": {"a": {"type": "fugue/unknown", "inputs": {}}}}}, "--nodes", nodes)
    expect("with a node list, a fugue/ id that Fugue does not list is not built in", code != 0 and "built-in" in out, out)
    for label, community in (("a zero issue", {"author": "a", "issue": 0}), ("a boolean issue", {"author": "a", "issue": True}), ("an empty author", {"author": " ", "issue": 1}), ("an extra key", {"author": "a", "issue": 1, "x": 1})):
        code, out = checked({**about, "community": community}, ok)
        expect(f"community with {label} fails bin/check", code != 0, out)
    hostile = {"fugue": 1, "graph": {"nodes": {"m": {"type": "fugue/load-models", "inputs": {"a": {"resource": "r", "hash": "sha256:" + "0" * 64, "name": osc}}}}}}
    code, out = checked({k: v for k, v in about.items() if k != "community"}, hostile)
    expect("a hostile model name with no requires.models is reported without raw control characters", code != 0 and "no source" in out and not any(ch in out for ch in raw), repr(out))
    code, out = checked({k: v for k, v in about.items() if k != "community"}, {"fugue": 1, "graph": {"nodes": {"l": {"type": "fugue/load-image", "inputs": {"file": "/home/x/a.png"}}}}})
    expect("bin/check refuses an absolute path in a file input", code != 0 and "local machine" in out, out)
    code, out = checked({k: v for k, v in about.items() if k != "community"}, {"fugue": 1, "graph": {"nodes": {"t": {"type": "fugue/text", "inputs": {"text": "/imagine a cat"}}}}})
    expect("bin/check leaves a prompt that starts with / alone", code == 0, out)

    # new-template --from: absolute path, and a file that is not a picture
    pic = os.path.join(tmp, "cat.jpg")
    open(pic, "wb").write(JPG)
    fake = os.path.join(tmp, "fake.png")
    open(fake, "w").write("not a picture")
    mine = os.path.join(tmp, "my.fugue")
    open(mine, "w").write(json.dumps({"graph": {"nodes": {"a": {"type": "fugue/load-image", "inputs": {"file": pic}}, "b": {"type": "fugue/load-image", "inputs": {"file": fake}}}}}))
    code, out = run("new-template", "zz-test-new", "--from", mine, "--category", "edit", env=env)
    text = open(root + "/zz-test-new/workflow.fugue").read() if code == 0 else ""
    expect("new-template copies a real picture, prints the real source -> destination, cuts the rest to a bare name",
           code == 0 and os.path.isfile(root + "/zz-test-new/inputs/cat.jpg") and f"{os.path.realpath(pic)} -> inputs/cat.jpg" in out
           and not os.path.exists(root + "/zz-test-new/inputs/fake.png") and tmp not in text, out + text)

    hidden = os.path.join(tmp, ".hidden.png")
    open(hidden, "wb").write(PNG)
    open(mine, "w").write(json.dumps({"graph": {"nodes": {"a": {"type": "fugue/load-image", "inputs": {"file": hidden}}}}}))
    shutil.rmtree(root + "/zz-test-new")
    code, out = run("new-template", "zz-test-new", "--from", mine, "--category", "edit", env=env)
    expect("a sample that starts with a dot gets a plain name (the feed skips dot files)",
           code == 0 and os.listdir(root + "/zz-test-new/inputs") == ["hidden.png"], out)

    shutil.rmtree(os.path.join(root, "zz-test-new"), ignore_errors=True)

    # ---- Hardening: picture structure (1 to 4) ----
    def jpeg(scan=b"\x12\x34", sos=SOS, tail=b"\xff\xd9", sof=SOF):
        return b"\xff\xd8" + sof + sos + scan + tail

    def webp(*chunks, vp8x=None):
        body = b"WEBP" + (vp8x or b"") + b"".join(k + struct.pack("<I", len(v)) + v + (b"\0" if len(v) & 1 else b"") for k, v in chunks)
        return b"RIFF" + struct.pack("<I", len(body)) + body

    VP8L = (b"VP8L", b"/\0\0\0\0")
    VP8 = (b"VP8 ", b"\0\0\0\x9d\x01\x2a\x01\0\x01\0")
    VP8X = b"VP8X" + struct.pack("<I", 10) + b"\0\0\0\0" + b"\0\0\0" + b"\0\0\0"
    anmf = (b"ANMF", b"\0" * 16 + b"VP8L" + struct.pack("<I", 5) + b"/\0\0\0\0" + b"\0")

    def png_with(*chunks, width=1, height=1, idat=True):
        out = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 0, 0, 0, 0))
        for kind, data in chunks:
            out += chunk(kind, data)
        return out + (chunk(b"IDAT", zlib.compress(b"\0\0")) if idat else b"") + chunk(b"IEND", b"")

    def picture_ok(label, name, data, ok):
        folder = os.path.join(root, "zz-pic")
        shutil.rmtree(folder, ignore_errors=True)
        os.makedirs(folder)
        json.dump({"title": "t", "description": "d", "category": "edit"}, open(folder + "/template.json", "w"))
        json.dump({"fugue": 1, "graph": {"nodes": {}}}, open(folder + "/workflow.fugue", "w"))
        open(folder + "/preview.png", "wb").write(PNG)
        os.makedirs(os.path.dirname(os.path.join(folder, name)), exist_ok=True)
        open(os.path.join(folder, name), "wb").write(data)
        code, out = run("check", env=env)
        shutil.rmtree(folder)
        expect(label, (code == 0) == ok, out)

    stuffed = jpeg(scan=b"\x12\xff\x00\x34\xff\xd0\x56", tail=b"\xff\xff\xd9")
    picture_ok("a JPEG with FF00 stuffing and a restart marker in its scan passes", "inputs/a.jpg", stuffed, True)
    picture_ok("a JPEG with an end marker inside its scan data and bytes after it is refused", "inputs/a.jpg", jpeg(tail=b"\xff\xd9" + b"payload" + b"\xff\xd9"), False)
    picture_ok("a JPEG whose scan runs to no end marker is refused", "inputs/a.jpg", jpeg(tail=b"\x12"), False)
    picture_ok("a JPEG with 17 scans is refused", "inputs/a.jpg", b"\xff\xd8" + SOF + (SOS + b"\x12") * 17 + b"\xff\xd9", False)
    picture_ok("a JPEG with 16 scans passes", "inputs/a.jpg", b"\xff\xd8" + SOF + (SOS + b"\x12") * 16 + b"\xff\xd9", True)
    picture_ok("a JPEG with a frame but no scan is refused", "inputs/a.jpg", b"\xff\xd8" + SOF + b"\xff\xd9", False)

    picture_ok("a simple WebP (VP8L) passes", "inputs/a.webp", webp(VP8L), True)
    picture_ok("a simple WebP (VP8) passes", "inputs/a.webp", webp(VP8), True)
    picture_ok("a WebP with an unknown chunk first is refused", "inputs/a.webp", webp((b"ABCD", b"1234"), VP8L), False)
    picture_ok("a WebP with an unknown chunk after VP8X is refused", "inputs/a.webp", webp(VP8L, (b"ABCD", b"1234"), vp8x=VP8X), False)
    picture_ok("a WebP with chunks after its one picture is refused", "inputs/a.webp", webp(VP8L, (b"EXIF", b"x")), False)
    picture_ok("a VP8X WebP with a VP8L picture passes", "inputs/a.webp", webp(VP8L, vp8x=VP8X), True)
    picture_ok("a WebP with no picture data is refused", "inputs/a.webp", webp(vp8x=VP8X), False)
    picture_ok("a WebP whose VP8 lacks its start code is refused", "inputs/a.webp", webp((b"VP8 ", b"\0\0\0\x00\x00\x00\x01\0\x01\0")), False)
    picture_ok("a WebP whose VP8L lacks its signature is refused", "inputs/a.webp", webp((b"VP8L", b"\x00\0\0\0\0")), False)
    picture_ok("an animated WebP of 64 frames passes", "inputs/a.webp", webp(*[anmf] * 64, vp8x=VP8X), True)
    picture_ok("an animated WebP of 65 frames is refused", "inputs/a.webp", webp(*[anmf] * 65, vp8x=VP8X), False)

    picture_ok("a PNG with no IDAT is refused", "inputs/a.png", png_with(idat=False), False)
    picture_ok("a PNG with a private chunk is refused", "inputs/a.png", png_with((b"prVt", b"x")), False)
    picture_ok("an APNG (acTL) is refused", "inputs/a.png", png_with((b"acTL", struct.pack(">II", 2, 0))), False)
    picture_ok("a PNG with text, gamma, sRGB, pHYs and tIME chunks passes", "inputs/a.png",
               png_with((b"tEXt", b"k\0v"), (b"gAMA", b"\0\0\xb1\x8f"), (b"sRGB", b"\0"), (b"pHYs", b"\0" * 9), (b"tIME", b"\x07\xe9\x0b\x1c\0\0\0")), True)
    picture_ok("a PNG with a zTXt chunk over 64 KB is refused", "inputs/a.png", png_with((b"zTXt", b"k\0\0" + os.urandom(70000))), False)
    picture_ok("a PNG of 4096 x 4096 passes", "inputs/a.png", png_with(width=4096, height=4096), True)
    picture_ok("a PNG of 4097 pixels wide is refused", "inputs/a.png", png_with(width=4097), False)
    picture_ok("a WebP of 4097 pixels wide is refused", "inputs/a.webp", webp(VP8L, vp8x=b"VP8X" + struct.pack("<I", 10) + b"\0" * 4 + (4096).to_bytes(3, "little") + b"\0" * 3), False)
    picture_ok("a JPEG of 4097 pixels wide is refused", "inputs/a.jpg", jpeg(sof=b"\xff\xc0\x00\x11\x08\x00\x01\x10\x01\x03\x01\x11\x00\x02\x11\x00\x03\x11\x00"), False)

    # ---- bin/check: every file under inputs/ and the template root (5) ----
    picture_ok("a bad picture under inputs/packshots/ is checked (a path part, not a substring)", "inputs/packshots/a.png", PNG[:-12], False)
    picture_ok("a sample in a sub-folder that is sound passes", "inputs/sub/a.png", PNG, True)
    picture_ok("a GIF in inputs/ is refused", "inputs/a.gif", b"GIF89a\1\0\1\0\0\0\0;", False)
    picture_ok("an SVG in inputs/ is refused", "inputs/a.svg", b"<svg xmlns='http://www.w3.org/2000/svg'/>", False)
    picture_ok("an extensionless file of an unknown kind in inputs/ is refused", "inputs/readme", b"just text", False)
    picture_ok("an extensionless PNG in inputs/ is refused", "inputs/a", PNG, False)
    picture_ok("a PNG named .jpg is refused", "inputs/a.jpg", PNG, False)
    picture_ok("an audio sample (FLAC) with its own extension passes", "inputs/a.flac", b"fLaC\0\0\0\0", True)
    picture_ok("an audio sample with the wrong extension is refused", "inputs/a.mp3", b"fLaC\0\0\0\0", False)
    picture_ok("a video sample that is not a video by its bytes is refused", "inputs/a.mp4", b"not a video at all", False)
    picture_ok("a sample over 600 KB in a sub-folder is refused", "inputs/deep/a.flac", b"fLaC" + b"\0" * (601 * 1024), False)
    picture_ok("a .cube table passes", "inputs/a.cube", b'TITLE "x"\nLUT_3D_SIZE 2\n0.0 0.0 0.0\n', True)
    picture_ok("a .cube file with something else in it is refused", "inputs/a.cube", b"LUT_3D_SIZE 2\n<script>\n", False)
    picture_ok("an unknown file at the template root is refused", "notes.txt", b"hello", False)
    picture_ok("an unknown folder at the template root is refused", "extra/a.png", PNG, False)

    # ---- duplicate JSON keys (6) ----
    code, out = checked({**about, "community": {"author": "a"}}, ok)
    expect("a template without duplicate keys passes", code == 0, out)
    folder = os.path.join(root, "zz-check")
    os.makedirs(folder, exist_ok=True)
    open(folder + "/template.json", "w").write('{"title": "t", "title": "u", "description": "d", "category": "edit"}')
    open(folder + "/workflow.fugue", "w").write(json.dumps(ok))
    open(folder + "/preview.png", "wb").write(PNG)
    code, out = run("check", env=env)
    expect("bin/check refuses a duplicate key in template.json", code != 0 and "appears twice" in out, out)
    open(folder + "/template.json", "w").write(json.dumps({"title": "t", "description": "d", "category": "edit"}))
    open(folder + "/workflow.fugue", "w").write('{"fugue": 1, "graph": {"nodes": {}, "nodes": {"a": 1}}}')
    code, out = run("check", env=env)
    expect("bin/check refuses a duplicate key in workflow.fugue", code != 0 and "appears twice" in out, out)
    shutil.rmtree(folder)
    code, out, folder = importing("dupkey.fuguepack", {**base, "p/workflow.fugue": '{"graph": {"nodes": {}}, "graph": {"nodes": {}}}'})
    expect("the importer refuses a duplicate key in workflow.fugue", code != 0 and "twice" in out and not os.path.exists(folder), out)
    code, out, folder = importing("dupkey2.fuguepack", {**base, "p/template.json": '{"title": "a", "title": "b"}'})
    expect("the importer refuses a duplicate key in the package's template.json", code != 0 and "twice" in out and not os.path.exists(folder), out)

    # ---- community templates (7) ----
    sha = "a" * 40
    source = f"https://huggingface.co/owner/repo/resolve/{sha}/model.safetensors"
    digest = "sha256:" + "1" * 64

    def with_model(src, **more):
        node = {"type": "fugue/load-models", "inputs": {"a": {"resource": "r", "hash": digest, "name": "m"}}}
        return {"fugue": 1, "graph": {"nodes": {"m": node}}, "requires": {"models": [{"hash": digest, "source": src, "size": 5}], **more}}

    code, out = checked(about, with_model(source))
    expect("a community template with a pinned Hugging Face .safetensors source passes", code == 0, out)
    code, out = checked(about, with_model(source.replace("model.safetensors", "dir/model.gguf")))
    expect("a community model source may be a .gguf in a folder", code == 0, out)
    for label, src in (("a branch instead of a commit", f"https://huggingface.co/owner/repo/resolve/main/model.safetensors"),
                       ("a short hash", f"https://huggingface.co/owner/repo/resolve/{sha[:12]}/model.safetensors"),
                       ("another host", f"https://example.com/owner/repo/resolve/{sha}/model.safetensors"),
                       ("a query string", source + "?download=true"),
                       ("a .ckpt file", source.replace(".safetensors", ".ckpt")),
                       ("a .. path", f"https://huggingface.co/owner/repo/resolve/{sha}/../x/model.safetensors"),
                       ("http", source.replace("https", "http"))):
        code, out = checked(about, with_model(src))
        expect(f"a community model source with {label} is refused", code != 0 and "requires.models" in out, out)
    code, out = checked({k: v for k, v in about.items() if k != "community"}, with_model("https://example.com/m.ckpt"))
    expect("the Hugging Face rule is for community templates only", code == 0, out)
    code, out = checked(about, with_model(source, packs=[{"id": "x", "version": "1"}]))
    expect("a community template with requires.packs is refused", code != 0 and "requires.packs" in out, out)
    code, out = checked({k: v for k, v in about.items() if k != "community"}, with_model(source, packs=[{"id": "x", "version": "1"}]))
    expect("requires.packs stays allowed for a maintainer's own template", code == 0, out)
    code, out, folder = importing("reqpacks.fuguepack", {**base, "p/workflow.fugue": flow({"requires": {"packs": [{"id": "x"}]}})})
    expect("the importer refuses requires.packs for a community import", code != 0 and "requires.packs" in out and not os.path.exists(folder), out)

    def saving(**inputs):
        return {"fugue": 1, "graph": {"nodes": {"s": {"type": "fugue/save-image", "inputs": inputs}}}}

    code, out = checked(about, saving(name="{date}/{model}_{time}", folder="renders/today"))
    expect("a save node with a plain name and a relative folder passes", code == 0, out)
    for key, value in (("name", "../x"), ("name", "a/../../x"), ("folder", ".."), ("folder", "a/../b"), ("folder", "/etc"), ("folder", "~/x"),
                       ("name", "/tmp/x"), ("folder", "C:\\Users\\x"), ("folder", "\\\\host\\share")):
        code, out = checked(about, saving(**{key: value}))
        expect(f"a community save node's {key} {value!r} is refused", code != 0 and "outside the output folder" in out, out)

    # ---- check-all names the root it checks, under its test-only variable (9) ----
    code, out = run("check-all", env=env)
    expect("bin/check-all prints the root it checks", f"Checking the templates in {root}" in out, out)
    code, out = run("check", env={"FUGUE_TEMPLATES_ROOT": os.path.join(tmp, "nowhere"), "FUGUE_TEMPLATES_TEST_ROOT": ""})
    expect("the old FUGUE_TEMPLATES_ROOT variable is no longer read", "nowhere" not in out, out)

    # ---- bin/check-pr-scope (8) ----
    def git(cwd, *args):
        done = subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", "-c", "commit.gpgsign=false", *args], cwd=cwd, capture_output=True, text=True)
        assert done.returncode == 0, done.stderr
        return done.stdout.strip()

    repo = os.path.join(tmp, "scope")
    os.makedirs(repo + "/old")
    json.dump({"title": "o", "description": "d", "category": "edit"}, open(repo + "/old/template.json", "w"))
    open(repo + "/README.md", "w").write("x")
    git(repo, "init", "-q", "-b", "main")
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "-m", "base")
    base_sha = git(repo, "rev-parse", "HEAD")

    def scope(label, ok, mutate):
        git(repo, "checkout", "-q", "-B", "pr", base_sha)
        mutate()
        git(repo, "add", "-A")
        git(repo, "commit", "-q", "--allow-empty", "-m", "pr")
        done = subprocess.run([sys.executable, os.path.join(BIN, "check-pr-scope"), base_sha, "HEAD"], cwd=repo, capture_output=True, text=True)
        expect(label, (done.returncode == 0) == ok, done.stdout + done.stderr)

    def add(name, **about_):
        os.makedirs(f"{repo}/{name}", exist_ok=True)
        json.dump({"title": "n", "description": "d", "category": "edit", **about_}, open(f"{repo}/{name}/template.json", "w"))

    scope("a pull request from outside that adds a community template passes", True, lambda: add("new-one", community={"author": "x"}))
    scope("a pull request from outside that adds a template without community is refused", False, lambda: add("new-two"))
    scope("a pull request from outside that edits a maintainer's template is refused", False, lambda: open(repo + "/old/workflow.fugue", "w").write("{}"))
    scope("a pull request from outside that deletes a template is refused", False, lambda: shutil.rmtree(repo + "/old"))
    scope("a pull request from outside that edits bin/ or the README is refused", False, lambda: open(repo + "/README.md", "w").write("changed"))
    scope("a pull request from outside that adds a community template and touches the README is refused", False,
          lambda: (add("new-three", community={"author": "x"}), open(repo + "/README.md", "w").write("changed")))

    # ---- bin/parse-submission, bin/submission-report, bin/fetch-attachment ----
    URL = "https://github.com/user-attachments/files/12345678/my-template.zip"

    def issue_body(title="My Template", description="It makes things.", category="Image editing (edit)", package=f"[my-template.zip]({URL})", extra="", confirm="- [x] I made this\n- [x] MIT"):
        return (f"### The package\n\n{package}\n\n### Title\n\n{title}\n\n### Description\n\n{description}{extra}\n\n### Category\n\n{category}\n\n"
                f"### Models used\n\nhttps://huggingface.co/a/b\n\n### Based on someone else's work?\n\n_No response_\n\n### Confirm\n\n{confirm}\n")

    def parse(label, body, ok, login="octocat", check=None):
        out_dir = os.path.join(tmp, "sub")
        shutil.rmtree(out_dir, ignore_errors=True)
        open(os.path.join(tmp, "body.md"), "w").write(body)
        code, out = run("parse-submission", "--body-file", os.path.join(tmp, "body.md"), "--login", login, "--issue", "7", "--out", out_dir, "--root", root, env=env)
        good = (code == 0) == ok and (check is None or check(out_dir) if code == 0 else True)
        expect(label, good, out)

    def read(d, k):
        return open(os.path.join(d, k)).read().strip()

    parse("a sample issue body is parsed into files", issue_body(), True, check=lambda d: (read(d, "id"), read(d, "category"), read(d, "url"), read(d, "author"), read(d, "title")) == ("my-template", "edit", URL, "octocat", "My Template"))
    parse("a CRLF body is parsed", issue_body().replace("\n", "\r\n"), True)
    parse("a title with Unicode and symbols becomes a slug", issue_body(title="Réstore  the PHOTO!! (v2)"), True, check=lambda d: read(d, "id") == "restore-the-photo-v2")
    parse("a title with no letters gets an id from the issue number", issue_body(title="!!!"), True, check=lambda d: read(d, "id") == "template-7")
    parse("a multi-line description is joined into one line", issue_body(description="One.\n\nTwo."), True, check=lambda d: read(d, "description") == "One. Two.")
    parse("a description heading typed inside a text box is refused", issue_body(extra="\n\n### Title\n\nEvil"), False)
    parse("a title with a control character is refused", issue_body(title="a\x1b]52;c;x\x07b"), False)
    parse("a title with a bidi override is refused", issue_body(title="a\u202eb"), False)
    parse("a title over 80 characters is refused", issue_body(title="x" * 81), False)
    parse("an unknown category is refused", issue_body(category="Evil (evil)"), False)
    parse("a package that is not an attachment link is refused", issue_body(package="https://evil.example/files/1/a.zip"), False)
    parse("a package link with a look-alike host is refused", issue_body(package="https://github.com.evil.example/user-attachments/files/1/a.zip"), False)
    parse("an attachment that is not a .zip is refused", issue_body(package="https://github.com/user-attachments/files/1/a.fuguepack"), False)
    parse("an empty required field is refused", issue_body(description="_No response_"), False)
    parse("Confirm boxes not ticked are refused", issue_body(confirm="- [x] one\n- [ ] two"), False)
    parse("an author that is not a plain login is refused", issue_body(), False, login="a b;rm")
    os.makedirs(os.path.join(root, "my-template"), exist_ok=True)
    parse("a title whose slug exists already is refused", issue_body(), False)
    shutil.rmtree(os.path.join(root, "my-template"))

    # What the Action does after the parse: the files it wrote feed the importer, and the form's description is kept.
    pkg = os.path.join(tmp, "e2e.zip")
    zip_of(pkg, {**base, "p/preview.png": PNG})
    parse("the form of the end-to-end run is parsed", issue_body(description="From the form."), True)
    sub = os.path.join(tmp, "sub")
    code, out = run("import-fuguepack", pkg, read(sub, "id"), "--author", read(sub, "author"), "--issue", "7", "--category", read(sub, "category"),
                    "--title", read(sub, "title"), "--description", read(sub, "description"), env=env)
    about = json.load(open(os.path.join(root, "my-template", "template.json"))) if code == 0 else {}
    expect("the importer takes the title and description of the form and marks the template community",
           code == 0 and about.get("title") == "My Template" and about.get("description") == "From the form." and about.get("community") == {"author": "octocat", "issue": 7}, out)
    code, out = run("check-all", env=env)
    expect("bin/check-all passes on what the Action's import step makes", code == 0, out)
    shutil.rmtree(os.path.join(root, "my-template"), ignore_errors=True)

    done = subprocess.run([sys.executable, os.path.join(BIN, "fetch-attachment"), "https://evil.example/x.zip", os.path.join(tmp, "x.zip")], capture_output=True, text=True)
    expect("fetch-attachment refuses an address that is not an attachment, before any network use", done.returncode != 0 and "not an attachment" in done.stderr, done.stderr)

    hostile_log = os.path.join(tmp, "failure.log")
    os.makedirs(os.path.join(tmp, "rep"), exist_ok=True)
    open(os.path.join(tmp, "rep", "failure.log"), "w").write("```\n@everyone [x](http://evil) \x1b]52;c;x\x07\u202e <img src=x>\n````\nend")
    code, out = run("submission-report", "failure", "--dir", os.path.join(tmp, "rep"), "--issue", "7")
    block = out.split("What to change")[0]
    expect("the failure comment fences a hostile log with a longer fence and escapes control characters",
           code == 0 and "`````\n" in block and "\x1b" not in out and "\u202e" not in out and "\\x1b" in out and block.count("`````") == 2, out)
    open(os.path.join(tmp, "rep", "check.log"), "w").write("1 problems")
    open(os.path.join(tmp, "rep", "review.md"), "w").write("Verdict: ok\n[click](http://evil) @someone")
    code, out = run("submission-report", "pr", "--dir", os.path.join(tmp, "rep"), "--issue", "7", "--id", "my-template", "--checks", "fail", "--review", os.path.join(tmp, "rep", "review.md"))
    expect("the pull request body names the issue, the failed checks, the CI note and fences the AI review",
           code == 0 and "From #7" in out and "Checks: FAILED" in out and "CI did not run" in out and "```\nVerdict: ok\n[click](http://evil) @someone\n```" in out, out)
    code, out = run("submission-report", "pr", "--dir", os.path.join(tmp, "rep"), "--issue", "7", "--id", "my-template", "--checks", "pass")
    expect("without a review the pull request body says it was skipped", code == 0 and "Skipped: no ANTHROPIC_API_KEY" in out, out)
    code, out = run("submission-report", "linked", "--issue", "7", "--pr", "https://github.com/bmaltais/fugue-workflows/pull/9", "--checks", "pass")
    expect("the link comment holds the pull request address", code == 0 and "pull/9" in out, out)
    code, out = run("submission-report", "linked", "--issue", "7", "--pr", "https://evil.example/x", "--checks", "pass")
    expect("the link comment refuses an address that is not a pull request", code != 0, out)


print(f"{len(failures)} failed" if failures else "all passed")
sys.exit(1 if failures else 0)
