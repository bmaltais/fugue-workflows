#!/usr/bin/env python3
"""The shape of every template, without Fugue: what CI checks first.

Fugue checks the rest (its own reading of template.json, the node versions, the Load Image
samples, and that each workflow compiles): `FUGUE_TEMPLATES=$PWD fugue template list --json`
and `fugue validate`.
"""
import json
import os
import re
import sys
import unicodedata

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.dont_write_bytecode = True
import _contrib as c  # noqa: E402  (safe(), the picture checks, the local path and built-in node rules)

ROOT = c.ROOT
SHA = re.compile(r"^sha256:[0-9a-f]{64}$")
PREVIEWS = ("preview.webp", "preview.png", "preview.jpg")
MAX_PREVIEW = 300 * 1024
MAX_INPUT = 600 * 1024
MAX_CLIP = 600 * 1024  # a moving preview (preview.webm) and its poster
problems = []

# bin/check [--nodes FILE]: FILE is `fugue node list --json` (bin/check-all makes it); without it a built-in node is one whose
# type starts with `fugue/`, which is only an approximation.
builtin = None
if len(sys.argv) == 3 and sys.argv[1] == "--nodes":
    try:
        with open(sys.argv[2], encoding="utf-8") as f:
            builtin = {n["id"] for n in json.load(f)["data"]["nodes"]}
    except (OSError, ValueError, KeyError, TypeError) as e:
        sys.exit(f"cannot read the node list {sys.argv[2]}: {e}")


def load(path):
    try:
        return c.json_load(path)  # a repeated key in one object is refused
    except (OSError, ValueError) as e:
        problems.append(f"{os.path.relpath(path, ROOT)}: {e}")
        return None


def handles(value, out):
    if isinstance(value, dict):
        if "resource" in value and isinstance(value.get("hash"), str):
            out[value["hash"]] = value
        for item in value.values():
            handles(item, out)
    elif isinstance(value, list):
        for item in value:
            handles(item, out)


categories = load(os.path.join(ROOT, "categories.json")) or {}
known = {c.get("id") for c in categories.get("categories", [])}

count = 0
for name in sorted(os.listdir(ROOT)):
    folder = os.path.join(ROOT, name)
    if name.startswith(".") or not os.path.isdir(folder) or name == "bin":
        continue
    count += 1
    if not re.match(r"^[a-z0-9][a-z0-9-]*$", name):
        problems.append(f"{name}: a template's folder name is lowercase letters, digits and dashes")
    about = load(os.path.join(folder, "template.json"))
    flow = load(os.path.join(folder, "workflow.fugue"))
    if about is not None and not isinstance(about, dict):
        problems.append(f"{name}/template.json: is not a JSON object")
        about = None
    if about is not None:
        for key in ("title", "description", "category"):
            if not isinstance(about.get(key), str) or not about[key].strip():
                problems.append(f"{name}/template.json: needs a {key}")
            elif "TODO" in about[key]:
                problems.append(f"{name}/template.json: the {key} is still a TODO")
        if about.get("category") not in known:
            problems.append(f"{name}/template.json: category {about.get('category')!r} is not in categories.json")
        if not isinstance(about.get("tags", []), list):
            problems.append(f"{name}/template.json: tags is a list")
    preview = next((p for p in PREVIEWS if os.path.isfile(os.path.join(folder, p))), None)
    if not preview:
        problems.append(f"{name}: needs a preview ({', '.join(PREVIEWS)})")
    # A moving preview: template.json's `preview` names a WebM, `poster` its still (the still preview above stays the fallback).
    named = set()  # the files of the template's root that template.json names
    if about is not None and "preview" in about:
        clip = about["preview"]
        if not isinstance(clip, str) or clip != os.path.basename(clip) or not os.path.isfile(os.path.join(folder, clip)):
            problems.append(f"{name}/template.json: preview {clip!r} is not a file of the folder")
        else:
            named.add(clip)
            if clip.endswith(".webm"):
                poster = about.get("poster")
                if not isinstance(poster, str) or poster != os.path.basename(poster) or not os.path.isfile(os.path.join(folder, poster)):
                    problems.append(f"{name}/template.json: a WebM preview needs a poster that is a file of the folder")
                else:
                    named.add(poster)
    # Everything in the folder, recursively, by path parts: no links, no odd names, only the known files at the root,
    # and every file under inputs/ a sound picture or a known audio or video kind by its bytes. packs/ is a maintainer's own, read by hand.
    seen_names = {}
    for here, dirs, files in os.walk(folder):
        rel_here = os.path.relpath(here, folder)
        top = None if rel_here == "." else rel_here.split(os.sep)[0]
        if top == "packs":
            dirs[:] = []
        for entry in sorted(dirs + files):
            path = os.path.join(here, entry)
            rel = os.path.relpath(path, folder)
            if os.path.islink(path):
                problems.append(f"{name}/{rel}: a link (only plain files)")
            if top is None and os.path.isdir(path) and entry not in ("inputs", "packs"):
                problems.append(f"{name}/{rel}: a folder a template does not have (only inputs/ and packs/)")
            if top in ("inputs", "packs"):
                if c.DANGEROUS.search(entry):
                    problems.append(f"{name}/{rel}: the name has a control or invisible character")
                key = (here, unicodedata.normalize("NFC", entry).casefold())
                if key in seen_names:
                    problems.append(f"{name}/{rel}: the name matches {seen_names[key]!r} by case or Unicode form")
                seen_names[key] = entry
        for f in files:
            path = os.path.join(here, f)
            rel = os.path.relpath(path, folder)
            if os.path.islink(path) or not os.path.isfile(path):
                continue
            parts = rel.split(os.sep)
            size = os.path.getsize(path)
            if len(parts) == 1:  # the root of the template
                if f in PREVIEWS or f in named:
                    limit = MAX_PREVIEW if f in PREVIEWS else MAX_CLIP
                    if size > limit:
                        problems.append(f"{name}/{f}: over {limit // 1024} KB")
                    kind, found = c.sniff(path)
                    ext = os.path.splitext(f)[1].lower().lstrip(".")
                    if f.endswith(".webm"):
                        if found != "webm":
                            problems.append(f"{name}/{f}: its bytes are not a WebM")
                    elif kind != "image":
                        problems.append(f"{name}/{f}: not a PNG, JPEG or WebP")
                    else:
                        problem = c.picture_problem(path)
                        if problem:
                            problems.append(f"{name}/{f}: {problem}")
                        elif ext not in c.MEDIA_EXTS[found]:
                            problems.append(f"{name}/{f}: its bytes are a {found}, not a .{ext}")
                elif f not in ("template.json", "workflow.fugue"):
                    problems.append(f"{name}/{f}: not a file a template has (template.json, workflow.fugue, a preview, what template.json names, inputs/, packs/)")
            elif parts[0] == "inputs":
                if size > MAX_INPUT:
                    problems.append(f"{name}/{rel}: over {MAX_INPUT // 1024} KB")
                kind, found = c.sniff(path)
                ext = os.path.splitext(f)[1].lower().lstrip(".")
                if not kind and ext == "cube":
                    problem = c.cube_problem(path)
                    if problem:
                        problems.append(f"{name}/{rel}: {problem}")
                elif not kind:
                    problems.append(f"{name}/{rel}: not a PNG, JPEG, WebP or a known audio or video file by its bytes or a .cube table (no GIF, SVG or unknown kinds)")
                elif ext not in c.MEDIA_EXTS[found]:
                    problems.append(f"{name}/{rel}: its bytes are a {found}" + (f", not a .{ext}" if ext else ", and it has no extension"))
                elif kind == "image":
                    problem = c.picture_problem(path)
                    if problem:
                        problems.append(f"{name}/{rel}: {problem}")
            elif parts[0] != "packs":
                problems.append(f"{name}/{rel}: a folder a template does not have (only inputs/ and packs/)")
    if not isinstance(flow, dict):
        if flow is not None:
            problems.append(f"{name}/workflow.fugue: is not a workflow (a JSON object)")
        continue
    for path in c.local_path_values(flow)[:3]:
        problems.append(f"{name}/workflow.fugue: a path on a local machine, {path[:60]!r} (use inputs/<name>)")
    if isinstance(about, dict) and "community" in about:
        community = about["community"]
        if not isinstance(community, dict) or set(community) not in ({"author"}, {"author", "issue"}):
            problems.append(f"{name}/template.json: community is {{\"author\": text}} with an optional \"issue\": number")
        else:
            who, issue = community["author"], community.get("issue", 1)
            if not isinstance(who, str) or not who.strip() or len(who) > 80 or c.DANGEROUS.search(who):
                problems.append(f"{name}/template.json: community.author is plain text, at most 80 characters")
            if not isinstance(issue, int) or isinstance(issue, bool) or issue < 1:
                problems.append(f"{name}/template.json: community.issue is a positive number")
        if os.path.lexists(os.path.join(folder, "packs")):
            problems.append(f"{name}: a community template carries no packs/")
        for problem in c.community_problems(flow)[:5]:
            problems.append(f"{name}/workflow.fugue: {problem}")
        for kind in c.foreign_nodes(flow, builtin)[:5]:
            problems.append(f"{name}/workflow.fugue: a community template may use only built-in nodes; {kind} is not one")
    used = {}
    handles(flow.get("graph", {}), used)
    handles(flow.get("groups", {}), used)
    requires = flow.get("requires") if isinstance(flow.get("requires"), dict) else {}
    models = requires.get("models") if isinstance(requires.get("models"), list) else []
    recorded = {m["hash"]: m for m in models if isinstance(m, dict) and isinstance(m.get("hash"), str)}
    for digest, handle in sorted(used.items()):
        label = handle.get("name", digest)
        if not SHA.match(digest or ""):
            problems.append(f"{name}: {label} has no sha256 hash")
        source = recorded.get(digest, {}).get("source")
        size = recorded.get(digest, {}).get("size")
        if not isinstance(size, int) or isinstance(size, bool) or size <= 0:
            problems.append(f"{name}: {label} has no size (its bytes) in requires.models")
        if not source:
            problems.append(f"{name}: {label} has no source in requires.models")
        elif not source.startswith("https://"):
            problems.append(f"{name}: {label}'s source is not https")

if count == 0:
    problems.append("no templates")
for problem in problems:
    print(c.safe(problem), file=sys.stderr)
print(f"{count} templates, {len(problems)} problems")
sys.exit(1 if problems else 0)
