#!/usr/bin/env python3
"""bin/validate-all <fugue binary>: every template's workflow passes `fugue validate`.

One error is allowed: a node of a pack the template carries in packs/<id> (`unknown_node_type` with
that `pack`). CI cannot install those packs, because installing and trusting a pack needs a person,
and Fugue registers only trusted packs; the template offers its carried pack when it is opened.
Every other error fails the check.

`fugue validate` puts a library group named only by its type id into the workflow before it
compiles (spec 5.3), as the CLI run does; the app compiles the file as it is and refuses it. So a
node whose type is a built-in group (`runtime.kind` "group" in `fugue node describe`) must also have
its definition in the workflow's `groups`, or the template fails Fugue's own test.
"""
import json
import pathlib
import subprocess
import sys

if len(sys.argv) != 2:
    sys.exit("usage: bin/validate-all <fugue binary>")
fugue = str(pathlib.Path(sys.argv[1]).resolve())
root = pathlib.Path(__file__).resolve().parent.parent
failed = 0
kinds = {}


def is_group(type_id):
    if type_id not in kinds:
        done = subprocess.run([fugue, "node", "describe", "--", type_id, "--json"], capture_output=True, text=True)
        try:
            nodes = json.loads(done.stdout)["data"]["nodes"]
            kinds[type_id] = bool(nodes) and nodes[0].get("runtime", {}).get("kind") == "group"
        except (json.JSONDecodeError, KeyError, TypeError):
            kinds[type_id] = False  # a type of a carried pack: validate reports it
    return kinds[type_id]


def not_embedded(workflow):
    """The group types the workflow uses and does not hold in `groups`."""
    held = set(workflow.get("groups", {}))
    scopes = [workflow.get("graph", {}).get("nodes", {})] + [g.get("nodes", {}) for g in workflow.get("groups", {}).values()]
    used = {n.get("type") for nodes in scopes for n in nodes.values()}
    return sorted(t for t in used if t and t not in held and is_group(t))


for flow in sorted(root.glob("*/workflow.fugue")):
    folder = flow.parent
    carried = {p.name for p in (folder / "packs").glob("*") if p.is_dir()}
    done = subprocess.run([fugue, "validate", "workflow.fugue", "--json"], cwd=folder, capture_output=True, text=True)
    try:
        reply = json.loads(done.stdout)
    except json.JSONDecodeError:
        print(f"invalid: {folder.name}: no JSON reply ({done.stderr.strip()})")
        failed += 1
        continue
    try:
        for type_id in not_embedded(json.loads(flow.read_text(encoding="utf-8"))):
            print(f"invalid: {folder.name}: the group {type_id} is used but not embedded in the workflow's groups")
            failed += 1
    except (OSError, ValueError, AttributeError):
        pass  # validate reports an unreadable file
    errors = [e for e in reply.get("errors", []) if e.get("severity", "error") == "error"]
    left = [e for e in errors if not (e.get("code") == "unknown_node_type" and e.get("pack") in carried)]
    if left or (not reply.get("ok") and not errors):
        failed += 1
        for e in left or [{"code": "?", "message": "validate failed with no error"}]:
            print(f"invalid: {folder.name}: [{e.get('code')}] {e.get('message')}")
print(f"{len(list(root.glob('*/workflow.fugue')))} workflows checked, {failed} invalid")
sys.exit(1 if failed else 0)
