#!/usr/bin/env python3
"""bin/check-pr-scope <base> <head>: what a pull request from someone without write access may change.

CI runs it (only for such a pull request): the files that differ between <base> and <head> may be only inside template
folders, and each of those folders, as it is at <head>, must be a community template (template.json has `community`).
A folder the pull request deletes, or any file outside a template folder (bin/, .github/, categories.json, the README),
is a maintainer's change and fails here. Python 3 standard library only; reads git, writes nothing.
"""
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.dont_write_bytecode = True
import _contrib as c  # noqa: E402

ID = re.compile(r"^[a-z0-9][a-z0-9-]*$")


def git(*args):
    done = subprocess.run(["git", *args], capture_output=True)
    return done.returncode, done.stdout


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    base, head = sys.argv[1:]
    code, out = git("diff", "--name-status", "--no-renames", "-z", base, head)
    if code:
        sys.exit("cannot read the difference between the two commits")
    fields = out.decode("utf-8", "surrogateescape").split("\0")[:-1]
    changes = list(zip(fields[0::2], fields[1::2]))
    problems, folders = [], {}
    for status, path in changes:
        top = path.split("/")[0]
        if "/" not in path or not ID.match(top) or top == "bin":
            problems.append(f"{path}: a change outside the template folders; only a maintainer changes this")
        else:
            folders.setdefault(top, []).append(status)
    for folder in sorted(folders):
        code, listing = git("ls-tree", "--name-only", head, folder + "/")
        if code or not listing.strip():
            problems.append(f"{folder}/: this pull request deletes a template; only a maintainer does that")
            continue
        code, text = git("show", f"{head}:{folder}/template.json")
        try:
            about = json.loads(text) if not code else None
        except ValueError:
            about = None
        if not isinstance(about, dict) or "community" not in about:
            problems.append(f"{folder}/template.json: a pull request from someone without write access may only add or change community "
                            "templates. Add \"community\": {\"author\": \"<your GitHub login>\"} (bin/import-fuguepack --author does it); "
                            "a maintainer takes over changes to the other templates")
    for problem in problems:
        print(c.safe(problem), file=sys.stderr)
    print(f"{len(folders)} template folders changed, {len(problems)} problems")
    sys.exit(1 if problems else 0)


main()
