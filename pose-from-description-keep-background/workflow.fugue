{
  "fugue": 1,
  "graph": {
    "nodes": {
      "compare": {
        "inputs": {
          "a": {
            "from": "scale.image"
          },
          "b": {
            "from": "edit.image"
          },
          "mode": "slider"
        },
        "type": "fugue/compare-images",
        "version": "1.0.0"
      },
      "describe": {
        "inputs": {
          "picture1": {
            "from": "scale.image"
          },
          "picture2": {
            "from": "load2.image"
          },
          "seed": {
            "from": "seed.value"
          }
        },
        "type": "local/describe-the-pictures",
        "version": "1.0.0"
      },
      "edit": {
        "inputs": {
          "instruction": {
            "from": "write.instruction"
          },
          "model": {
            "from": "models.model"
          },
          "picture": {
            "from": "scale.image"
          },
          "references": [
            {
              "from": "scale.image"
            }
          ],
          "seed": {
            "from": "seed.value"
          }
        },
        "type": "local/edit-with-klein-9b",
        "version": "1.0.0"
      },
      "extra": {
        "inputs": {
          "text": ""
        },
        "type": "fugue/text",
        "version": "1.0.0"
      },
      "load": {
        "inputs": {
          "file": "inputs/woman-in-park.jpg"
        },
        "type": "fugue/load-image",
        "version": "1.0.0"
      },
      "load2": {
        "inputs": {
          "file": "inputs/ballet-pose.jpg"
        },
        "type": "fugue/load-image",
        "version": "1.0.0"
      },
      "models": {
        "inputs": {
          "diffusion_model": {
            "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6",
            "name": "flux-2-klein-9b-Q8_0.gguf",
            "resource": "fugue/diffusion-model"
          },
          "text_encoder": {
            "hash": "sha256:408b955510e196121c1c375201744783b5c9a43c7956d73fc78df54c66e883d6",
            "name": "qwen3/Qwen3-8B-Q8_0.gguf",
            "resource": "fugue/text-encoder"
          },
          "vae": {
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
            "name": "flux2-vae.safetensors",
            "resource": "fugue/vae"
          }
        },
        "type": "fugue/load-models",
        "version": "1.0.0"
      },
      "save": {
        "inputs": {
          "image": {
            "from": "edit.image"
          },
          "name": "pose-from-description-keep-background"
        },
        "type": "fugue/save-image",
        "version": "1.0.0"
      },
      "scale": {
        "inputs": {
          "image": {
            "from": "load.image"
          },
          "megapixels": 1,
          "method": "lanczos"
        },
        "type": "fugue/resize-megapixels",
        "version": "1.0.0"
      },
      "seed": {
        "inputs": {
          "value": 1
        },
        "type": "fugue/number",
        "version": "1.0.0"
      },
      "show_instruction": {
        "inputs": {
          "value": {
            "from": "write.instruction"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "show_pose": {
        "inputs": {
          "value": {
            "from": "describe.pose"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "show_setting": {
        "inputs": {
          "value": {
            "from": "describe.setting"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "show_subject": {
        "inputs": {
          "value": {
            "from": "describe.subject"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "show_support": {
        "inputs": {
          "value": {
            "from": "describe.support"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "write": {
        "inputs": {
          "extra": {
            "from": "extra.text"
          },
          "pose": {
            "from": "describe.pose"
          },
          "seed": {
            "from": "seed.value"
          },
          "setting": {
            "from": "describe.setting"
          },
          "subject": {
            "from": "describe.subject"
          },
          "support": {
            "from": "describe.support"
          }
        },
        "type": "local/write-the-edit-instruction",
        "version": "1.0.0"
      }
    }
  },
  "groups": {
    "local/describe-the-pictures": {
      "category": "Text",
      "description": "A language model that reads images writes four texts: picture 1's setting without its subject, picture 2's body pose without its person, what picture 2's pose stands, sits or leans on, and the subject of picture 1 as it looks (clothes, shoes, hair, age, accessories). Each prompt is under Advanced.",
      "inputs": [
        {
          "label": "Picture 1",
          "name": "picture1",
          "targets": [
            "setting.image",
            "subject.image"
          ]
        },
        {
          "label": "Picture 2",
          "name": "picture2",
          "targets": [
            "pose.image",
            "support.image"
          ]
        },
        {
          "label": "Seed",
          "name": "seed",
          "targets": [
            "setting.seed",
            "pose.seed",
            "support.seed",
            "subject.seed"
          ]
        },
        {
          "label": "Setting: question",
          "name": "setting_prompt",
          "section": "Advanced",
          "targets": [
            "setting.prompt"
          ]
        },
        {
          "label": "Setting: instructions",
          "name": "setting_system",
          "section": "Advanced",
          "targets": [
            "setting.system"
          ]
        },
        {
          "label": "Pose: question",
          "name": "pose_prompt",
          "section": "Advanced",
          "targets": [
            "pose.prompt"
          ]
        },
        {
          "label": "Pose: instructions",
          "name": "pose_system",
          "section": "Advanced",
          "targets": [
            "pose.system"
          ]
        },
        {
          "label": "Support: question",
          "name": "support_prompt",
          "section": "Advanced",
          "targets": [
            "support.prompt"
          ]
        },
        {
          "label": "Support: instructions",
          "name": "support_system",
          "section": "Advanced",
          "targets": [
            "support.system"
          ]
        },
        {
          "label": "Subject: question",
          "name": "subject_prompt",
          "section": "Advanced",
          "targets": [
            "subject.prompt"
          ]
        },
        {
          "label": "Subject: instructions",
          "name": "subject_system",
          "section": "Advanced",
          "targets": [
            "subject.system"
          ]
        }
      ],
      "name": "Describe the pictures",
      "nodes": {
        "pose": {
          "inputs": {
            "prompt": "Describe only the body pose in this photo.",
            "system": "You describe body poses for an artist's pose chart. You see a photo. Answer with one paragraph of 2 or 3 plain sentences that say only how the body is arranged: which way it faces (front, side, three-quarter, from behind), where the weight is, what each leg and each arm does, where the hands are, how the torso leans, where the head turns and looks. Never mention who or what the person is (no dancer, woman, man), clothes, shoes, hair, face, colors, the setting or the background. Start with 'The body'."
          },
          "type": "fugue/text-generate",
          "version": "1.0.0"
        },
        "setting": {
          "inputs": {
            "prompt": "Describe only the setting of this photo, without its subject.",
            "system": "You describe the setting of a photo for a set designer who will rebuild the place without the subject. You see a photo. Answer with one paragraph of 3 to 5 plain sentences about the place only: what kind of place it is, the background and the objects in it, the ground, the light (direction, softness, time of day, colors), the camera angle and distance, the mood and the photo style. Leave the main subject out completely: no person, animal or main object, no clothes, no face, no body, no pose, no age or gender. Describe the place as if it were empty. Start with 'The scene is'."
          },
          "type": "fugue/text-generate",
          "version": "1.0.0"
        },
        "subject": {
          "inputs": {
            "prompt": "Describe only the clothes, shoes, hair, age and accessories of the person in this photo.",
            "system": "You describe what a person wears and carries for a costume designer who must dress the same person again. You see a photo. Answer with one short paragraph of 2 or 3 plain sentences that lists, exactly as they are: every visible garment with its color, cut, material and pattern; the shoes (type, color, material, heel or sole; say 'barefoot' if there are none, or 'shoes not visible' if hidden); the hair (length, color, style); the apparent age; and any accessories (jewelry, bag, hat, glasses, watch). Be precise about colors and shapes, and describe only what you see. Never mention the pose, the body position, the setting, the background, the light, the face, the expression or who the person is. Start with 'The subject wears'."
          },
          "type": "fugue/text-generate",
          "version": "1.0.0"
        },
        "support": {
          "inputs": {
            "prompt": "List only what the body stands, sits, leans or steps on or against in this photo.",
            "system": "You help an artist adapt a pose to another place. You see a photo of a person. Name only the objects and surfaces the body relies on: stairs or a step, a wall, a chair, a railing, a rock, a table, a ledge, a bar, a floor or the ground, and how the body uses each one (feet on the second step, back against the wall, one hand on the rail). One or two plain sentences. Never describe the person, clothes, face, colors or the rest of the background. If the body just stands on flat ground and touches nothing, answer exactly: None, the body stands on flat ground."
          },
          "type": "fugue/text-generate",
          "version": "1.0.0"
        }
      },
      "outputs": [
        {
          "from": "setting.text",
          "label": "Setting",
          "name": "setting"
        },
        {
          "from": "pose.text",
          "label": "Pose",
          "name": "pose"
        },
        {
          "from": "support.text",
          "label": "Support",
          "name": "support"
        },
        {
          "from": "subject.text",
          "label": "Subject",
          "name": "subject"
        }
      ],
      "version": "1.0.0"
    },
    "local/edit-with-klein-9b": {
      "category": "Image/Edit",
      "description": "FLUX.2 Klein 9B edits picture 1 as told by the instruction: encodes the picture, samples in 4 steps and decodes. It never sees another picture. A Color Match then moves the result's colors toward picture 1's (Advanced: Color match, 0 is off). Then Remove Background finds the person in picture 1 and in the result, and the result is pasted over picture 1 inside the joined, slightly grown and feathered person mask, so the setting stays pixel for pixel as in picture 1 (Advanced: Keep the background, 0 is off and gives the plain result, 1 is full).",
      "inputs": [
        {
          "label": "Models",
          "name": "model",
          "targets": [
            "encode_ref.model",
            "encode.model",
            "sample.model"
          ]
        },
        {
          "label": "Picture",
          "name": "picture",
          "targets": [
            "encode_ref.image",
            "color.reference",
            "bg1.image",
            "paste.destination"
          ]
        },
        {
          "label": "Reference pictures",
          "name": "references",
          "targets": [
            "encode.references"
          ]
        },
        {
          "label": "Instruction",
          "name": "instruction",
          "targets": [
            "encode.prompt"
          ]
        },
        {
          "label": "Seed",
          "name": "seed",
          "targets": [
            "sample.seed"
          ]
        },
        {
          "label": "Steps",
          "name": "steps",
          "section": "Advanced",
          "targets": [
            "sample.steps"
          ]
        },
        {
          "label": "Guidance",
          "name": "guidance",
          "section": "Advanced",
          "targets": [
            "sample.guidance"
          ]
        },
        {
          "label": "Sampler",
          "name": "sampler",
          "section": "Advanced",
          "targets": [
            "sample.sampler"
          ]
        },
        {
          "default": 0.8,
          "label": "Color match",
          "name": "color_match",
          "section": "Advanced",
          "targets": [
            "color.strength"
          ]
        },
        {
          "default": 1,
          "label": "Keep the background",
          "name": "keep_background",
          "section": "Advanced",
          "targets": [
            "keep.opacity"
          ]
        },
        {
          "default": 6,
          "label": "Background: grow the person's mask",
          "name": "background_grow",
          "section": "Advanced",
          "targets": [
            "grow.expand"
          ]
        },
        {
          "default": 12,
          "label": "Background: feather",
          "name": "background_feather",
          "section": "Advanced",
          "targets": [
            "soft.radius"
          ]
        }
      ],
      "name": "Edit with Klein 9B",
      "nodes": {
        "bg1": {
          "inputs": {
            "model": {
              "hash": "sha256:5600024376f572a557870a5eb0afb1e5961636bef4e1e22132025467d0f03333",
              "name": "BiRefNet-general-bb_swin_v1_tiny-epoch_232.onnx",
              "resource": "io.github.bmaltais.fugue-remove-background/birefnet-model"
            }
          },
          "type": "io.github.bmaltais.fugue-remove-background/remove-background",
          "version": "1.0.1"
        },
        "bg2": {
          "inputs": {
            "image": {
              "from": "color.image"
            },
            "model": {
              "hash": "sha256:5600024376f572a557870a5eb0afb1e5961636bef4e1e22132025467d0f03333",
              "name": "BiRefNet-general-bb_swin_v1_tiny-epoch_232.onnx",
              "resource": "io.github.bmaltais.fugue-remove-background/birefnet-model"
            }
          },
          "type": "io.github.bmaltais.fugue-remove-background/remove-background",
          "version": "1.0.1"
        },
        "color": {
          "inputs": {
            "image": {
              "from": "decode.image"
            }
          },
          "type": "fugue/color-match",
          "version": "1.0.0"
        },
        "decode": {
          "inputs": {
            "latent": {
              "from": "sample.latent"
            }
          },
          "type": "fugue/vae-decode",
          "version": "1.0.0"
        },
        "encode": {
          "inputs": {},
          "type": "fugue/text-encode",
          "version": "1.0.0"
        },
        "encode_ref": {
          "inputs": {},
          "type": "fugue/vae-encode",
          "version": "1.1.0"
        },
        "grow": {
          "inputs": {
            "expand": 6,
            "mask": {
              "from": "union.mask"
            }
          },
          "type": "fugue/grow-mask",
          "version": "1.0.1"
        },
        "keep": {
          "inputs": {
            "base": {
              "from": "color.image"
            },
            "mode": "normal",
            "opacity": 1,
            "top": {
              "from": "paste.image"
            }
          },
          "type": "fugue/blend",
          "version": "1.0.0"
        },
        "paste": {
          "inputs": {
            "mask": {
              "from": "soft.mask"
            },
            "resize_source": true,
            "source": {
              "from": "color.image"
            }
          },
          "type": "fugue/composite-masked",
          "version": "1.0.0"
        },
        "sample": {
          "inputs": {
            "conditioning": {
              "from": "encode.conditioning"
            },
            "guidance": 1,
            "latent": {
              "from": "encode_ref.latent"
            },
            "sampler": "euler",
            "steps": 4
          },
          "type": "fugue/sampler",
          "version": "1.0.0"
        },
        "soft": {
          "inputs": {
            "direction": "outward",
            "mask": {
              "from": "grow.mask"
            },
            "radius": 12
          },
          "type": "fugue/feather-mask",
          "version": "1.0.0"
        },
        "union": {
          "inputs": {
            "destination": {
              "from": "bg1.mask"
            },
            "operation": "or",
            "source": {
              "from": "bg2.mask"
            }
          },
          "type": "fugue/combine-masks",
          "version": "1.0.0"
        }
      },
      "outputs": [
        {
          "from": "keep.image",
          "label": "Image",
          "name": "image"
        }
      ],
      "version": "1.0.0"
    },
    "local/write-the-edit-instruction": {
      "category": "Text",
      "description": "A text-only language model joins the setting, the subject's look, the pose, what the pose relies on and your extra wishes into one edit instruction for an image editing model. The brief it reads (headings and block order) is the Brief template, and the model's instructions, both under Advanced.",
      "inputs": [
        {
          "label": "Setting",
          "name": "setting",
          "targets": [
            "brief.a"
          ]
        },
        {
          "label": "Pose",
          "name": "pose",
          "targets": [
            "brief.b"
          ]
        },
        {
          "label": "Support",
          "name": "support",
          "targets": [
            "brief.c"
          ]
        },
        {
          "label": "Subject",
          "name": "subject",
          "targets": [
            "brief.d"
          ]
        },
        {
          "label": "Extra instructions",
          "name": "extra",
          "targets": [
            "brief.e"
          ]
        },
        {
          "label": "Seed",
          "name": "seed",
          "targets": [
            "instruction.seed"
          ]
        },
        {
          "label": "Brief template",
          "name": "brief_template",
          "section": "Advanced",
          "targets": [
            "brief.template"
          ]
        },
        {
          "label": "Instructions",
          "name": "system",
          "section": "Advanced",
          "targets": [
            "instruction.system"
          ]
        }
      ],
      "name": "Write the edit instruction",
      "nodes": {
        "brief": {
          "inputs": {
            "template": "SETTING OF IMAGE 1 (what is really there):\n{a}\n\nSUBJECT OF IMAGE 1 (clothes, shoes, hair, age and accessories that must stay exactly as they are):\n{d}\n\nBODY POSE TO GIVE THE SUBJECT (taken from another photo):\n{b}\n\nWHAT THAT POSE STANDS, SITS, LEANS OR STEPS ON IN THE OTHER PHOTO:\n{c}\n\nEXTRA WISHES (may be empty):\n{e}"
          },
          "type": "fugue/text-template",
          "version": "1.0.0"
        },
        "instruction": {
          "inputs": {
            "prompt": {
              "from": "brief.text"
            },
            "system": "You write the instruction for an image editing model that gets image 1 and your text, and nothing else; it never sees any other photo. You are given blocks with headings: the setting of image 1, the subject of image 1 (its clothes, shoes, hair, age and accessories), a body pose, what that pose relied on in another photo, and maybe extra wishes. Write one paragraph of at most 150 words, in the imperative, that starts with 'Edit image 1.' It must say, in this order: keep the setting exactly as it is (name its place, background, light and camera angle in a few words, from the setting block only); keep the subject exactly as it is: say the face stays, then name each item of the subject block in plain words (every garment, the shoes, the hair, the accessories, with their colors) as staying unchanged, and say the shoes and clothes do not change in color, type or style; change only the body pose to the given pose, described in plain words. Then make the pose fit the setting. For each thing the pose relied on, check the setting block: if the setting has that thing or something that does the same job (a step, a rock, a curb, a bench, a wall, a railing), say the body uses it; if it does not, say the body takes the same stance in a natural way on what the setting does offer (standing on the ground, sitting on the floor or on a nearby object that the setting block names), so that no limb floats in the air and nothing leans on air. Do not add any object, building or furniture that the setting block does not name, and never name another photo, image 2, or any prop the setting lacks and do not write the name of any missing object, not even to say it is absent (an editing model would draw it); write only what the body does on what the setting block names, for example 'plants the foot on the ground'. Apply any extra wishes. Answer with the instruction only."
          },
          "type": "fugue/text-generate",
          "version": "1.0.0"
        }
      },
      "outputs": [
        {
          "from": "instruction.text",
          "label": "Instruction",
          "name": "instruction"
        }
      ],
      "version": "1.0.0"
    }
  },
