{
  "fugue": 1,
  "app": {
    "format": 1,
    "title": "Expand",
    "description": "Adds room around a picture and draws the new border to match it (FLUX.2 Klein 4B).",
    "defaultView": "app",
    "inputs": [
      {
        "role": "image",
        "targets": [
          "load.file"
        ],
        "label": "Picture"
      },
      {
        "role": "prompt",
        "targets": [
          "encode.prompt"
        ],
        "label": "What belongs in the new area",
        "default": "Extend the picture beyond its edges, continuing the scene."
      },
      {
        "name": "left",
        "targets": [
          "pad.left"
        ],
        "label": "Add on the left (pixels)",
        "min": 0,
        "max": 1024
      },
      {
        "name": "right",
        "targets": [
          "pad.right"
        ],
        "label": "Add on the right (pixels)",
        "min": 0,
        "max": 1024
      },
      {
        "name": "top",
        "targets": [
          "pad.top"
        ],
        "label": "Add on the top (pixels)",
        "min": 0,
        "max": 1024
      },
      {
        "name": "bottom",
        "targets": [
          "pad.bottom"
        ],
        "label": "Add on the bottom (pixels)",
        "min": 0,
        "max": 1024
      },
      {
        "role": "seed",
        "targets": [
          "sample.seed"
        ],
        "label": "Seed"
      },
      {
        "name": "steps",
        "targets": [
          "sample.steps"
        ],
        "label": "Steps",
        "min": 1,
        "max": 8,
        "section": "Advanced"
      },
      {
        "name": "feathering",
        "targets": [
          "pad.feathering"
        ],
        "label": "Edge blend (pixels)",
        "min": 0,
        "max": 256,
        "section": "Advanced"
      }
    ],
    "outputs": [
      {
        "node": "save",
        "label": "Expanded picture"
      }
    ]
  },
  "graph": {
    "nodes": {
      "load": {
        "type": "fugue/load-image",
        "version": "1.1.0",
        "inputs": {
          "file": "inputs/cat-768.jpg"
        }
      },
      "pad": {
        "type": "fugue/pad",
        "version": "1.0.1",
        "inputs": {
          "image": {
            "from": "load.image"
          },
          "left": 256,
          "right": 256,
          "top": 0,
          "bottom": 0,
          "feathering": 40
        }
      },
      "models": {
        "inputs": {
          "diffusion_model": {
            "resource": "fugue/diffusion-model",
            "name": "flux-2-klein-4b-Q8_0.gguf",
            "hash": "sha256:24a812e8f9b640e21c784164ea48571d8017ca22873696f4badeeabb006d509c"
          },
          "text_encoder": {
            "resource": "fugue/text-encoder",
            "name": "Qwen3-4B-Q8_0.gguf",
            "hash": "sha256:eed555233267a33c7e8ee31682762cc7751b3f6d224039086e0e846f05fffa5d"
          },
          "vae": {
            "resource": "fugue/vae",
            "name": "flux2-vae.safetensors",
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5"
          }
        },
        "type": "fugue/load-models",
        "version": "1.0.0"
      },
      "encode": {
        "type": "fugue/text-encode",
        "version": "1.0.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": "A cat sitting on a wooden windowsill by a window, with green plants in terracotta pots, soft daylight.",
          "references": [
            {
              "from": "load.image"
            }
          ]
        }
      },
      "vae_encode": {
        "type": "fugue/vae-encode",
        "version": "1.1.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "image": {
            "from": "pad.image"
          },
          "mask": {
            "from": "pad.mask"
          }
        }
      },
      "sample": {
        "type": "fugue/sampler",
        "version": "1.0.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "conditioning": {
            "from": "encode.conditioning"
          },
          "latent": {
            "from": "vae_encode.latent"
          },
          "sampler": "euler",
          "seed": {
            "auto": "random"
          },
          "steps": 4,
          "guidance": 1,
          "denoise": 1
        }
      },
      "decode": {
        "type": "fugue/vae-decode",
        "version": "1.0.0",
        "inputs": {
          "latent": {
            "from": "sample.latent"
          }
        }
      },
      "composite": {
        "type": "fugue/composite-masked",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "pad.image"
          },
          "source": {
            "from": "decode.image"
          },
          "mask": {
            "from": "pad.mask"
          }
        }
      },
      "preview": {
        "type": "fugue/preview",
        "version": "1.0.0",
        "inputs": {
          "value": {
            "from": "composite.image"
          }
        }
      },
      "save": {
        "type": "fugue/save-image",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "composite.image"
          },
          "name": "outpaint"
        }
      }
    }
  },
  "layout": {
    "nodes": {
      "load": {
        "pos": [
          0,
          0
        ]
      },
      "models": {
        "pos": [
          0,
          520
        ]
      },
      "pad": {
        "pos": [
          380,
          0
        ]
      },
      "encode": {
        "pos": [
          760,
          0
        ]
      },
      "vae_encode": {
        "pos": [
          760,
          420
        ]
      },
      "sample": {
        "pos": [
          1100,
          0
        ]
      },
      "decode": {
        "pos": [
          1440,
          0
        ]
      },
      "composite": {
        "pos": [
          1780,
          0
        ]
      },
      "save": {
        "pos": [
          2120,
          0
        ]
      },
      "preview": {
        "pos": [
          2120,
          460
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0",
    "models": [
      {
        "resource": "fugue/diffusion-model",
        "hash": "sha256:24a812e8f9b640e21c784164ea48571d8017ca22873696f4badeeabb006d509c",
        "name": "flux-2-klein-4b-Q8_0.gguf",
        "source": "https://huggingface.co/unsloth/FLUX.2-klein-4B-GGUF/resolve/main/flux-2-klein-4b-Q8_0.gguf",
        "size": 4300644928
      },
      {
        "resource": "fugue/text-encoder",
        "hash": "sha256:eed555233267a33c7e8ee31682762cc7751b3f6d224039086e0e846f05fffa5d",
        "name": "Qwen3-4B-Q8_0.gguf",
        "source": "https://huggingface.co/unsloth/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q8_0.gguf",
        "size": 4280405792
      },
      {
        "resource": "fugue/vae",
        "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
        "name": "flux2-vae.safetensors",
        "source": "https://huggingface.co/Comfy-Org/Flux-2-Dev/resolve/main/split_files/vae/flux2-vae.safetensors",
        "size": 336213556
      }
    ]
  }
}
