            "from": "models.model"
          },
          "conditioning": {
            "from": "encode.conditioning"
          },
          "latent": {
            "from": "vae_encode.latent"
          },
          "sampler": "euler",
          "seed": {
            "auto": "random"
          },
          "steps": 4,
          "guidance": 1,
          "denoise": 1
        }
      },
      "decode": {
        "type": "fugue/vae-decode",
        "version": "1.0.0",
        "inputs": {
          "latent": {
            "from": "sample.latent"
          }
        }
      },
      "composite": {
        "type": "fugue/composite-masked",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "pad.image"
          },
          "source": {
            "from": "decode.image"
          },
          "mask": {
            "from": "pad.mask"
          }
        }
      },
      "preview": {
        "type": "fugue/preview",
        "version": "1.0.0",
        "inputs": {
