{
  "fugue": 1,
  "graph": {
    "nodes": {
      "load": {
        "type": "fugue/load-image",
        "version": "1.1.0",
        "inputs": {
          "file": "inputs/collage.jpg",
          "mask": "inputs/collage-mask.png"
        }
      },
      "models": {
        "type": "fugue/load-models",
        "version": "1.0.0",
        "inputs": {
          "diffusion_model": {
            "resource": "fugue/diffusion-model",
            "name": "flux-2-klein-4b-Q8_0.gguf",
            "hash": "sha256:24a812e8f9b640e21c784164ea48571d8017ca22873696f4badeeabb006d509c"
          },
          "text_encoder": {
            "resource": "fugue/text-encoder",
            "name": "Qwen3-4B-Q8_0.gguf",
            "hash": "sha256:eed555233267a33c7e8ee31682762cc7751b3f6d224039086e0e846f05fffa5d"
          },
          "vae": {
            "resource": "fugue/vae",
            "name": "flux2-vae.safetensors",
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5"
          }
        }
      },
      "work": {
        "type": "fugue/resize-megapixels",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "load.image"
          },
          "megapixels": 1,
          "multiple": 16,
          "method": "lanczos"
        }
      },
      "outer": {
        "type": "fugue/grow-mask",
        "version": "1.0.1",
        "inputs": {
          "mask": {
            "from": "mask_work.image"
          },
          "expand": 48,
          "tapered_corners": true
        }
      },
      "inner": {
        "type": "fugue/grow-mask",
        "version": "1.0.1",
        "inputs": {
          "mask": {
            "from": "mask_work.image"
          },
          "expand": -48,
          "tapered_corners": true
        }
      },
      "seam": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "outer.mask"
          },
          "source": {
            "from": "inner.mask"
          },
          "operation": "subtract"
        }
      },
      "pasted_level": {
        "type": "fugue/solid-mask",
        "version": "1.0.1",
        "inputs": {
          "value": 0.25,
          "width": {
            "from": "work.width"
          },
          "height": {
            "from": "work.height"
          }
        }
      },
      "pasted": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "inner.mask"
          },
          "source": {
            "from": "pasted_level.mask"
          },
          "operation": "multiply"
        }
      },
      "seam_pasted": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "seam.mask"
          },
          "source": {
            "from": "pasted.mask"
          },
          "operation": "add"
        }
      },
      "base_level": {
        "type": "fugue/solid-mask",
        "version": "1.0.1",
        "inputs": {
          "value": 0.5,
          "width": {
            "from": "work.width"
          },
          "height": {
            "from": "work.height"
          }
        }
      },
      "strength_map": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "seam_pasted.mask"
          },
          "source": {
            "from": "base_level.mask"
          },
          "operation": "add"
        }
      },
      "soft": {
        "type": "fugue/blur",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "work.image"
          },
          "radius": 30,
          "sigma": 1.0
        }
      },
      "seamed": {
        "type": "fugue/composite-masked",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "work.image"
          },
          "source": {
            "from": "soft.image"
          },
          "mask": {
            "from": "seam.mask"
          },
          "x": 0,
          "y": 0,
          "resize_source": false
        }
      },
      "prompt_join": {
        "type": "fugue/text-concat",
        "version": "1.0.0",
        "inputs": {
          "a": "Make this one photograph: blend any pasted part into the scene and remove hard edges and halos, and make the light direction, colour temperature, shadows, sharpness and grain consistent across the whole picture. Keep every object, person and face unchanged.",
          "b": "",
          "separator": " "
        }
      },
      "encode": {
        "type": "fugue/text-encode",
        "version": "1.0.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": {
            "from": "prompt_join.text"
          },
          "references": [
            {
              "from": "seamed.image"
            }
          ]
        }
      },
      "vae_encode": {
        "type": "fugue/vae-encode",
        "version": "1.1.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "image": {
            "from": "seamed.image"
          },
          "mask": {
            "from": "strength_map.mask"
          }
        }
      },
      "sample": {
        "type": "fugue/sampler",
        "version": "1.2.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "conditioning": {
            "from": "encode.conditioning"
          },
          "latent": {
            "from": "vae_encode.latent"
          },
          "seed": {
            "auto": "random"
          },
          "steps": 4,
          "guidance": 1,
          "denoise": 0.9,
          "soft_mask": true
        }
      },
      "decode": {
        "type": "fugue/vae-decode",
        "version": "1.0.0",
        "inputs": {
          "latent": {
            "from": "sample.latent"
          }
        }
      },
      "back": {
        "type": "fugue/resize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "decode.image"
          },
          "width": {
            "from": "load.width"
          },
          "height": {
            "from": "load.height"
          },
          "fit": "stretch",
          "method": "lanczos"
        }
      },
      "match": {
        "type": "fugue/color-match",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "back.image"
          },
          "reference": {
            "from": "load.image"
          },
          "strength": 1
        }
      },
      "preview": {
        "type": "fugue/preview",
        "version": "1.0.0",
        "inputs": {
          "value": {
            "from": "match.image"
          }
        }
      },
      "save": {
        "type": "fugue/save-image",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "match.image"
          },
          "name": "harmonized"
        }
      },
      "mask_work": {
        "type": "fugue/resize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "load.mask"
          },
          "width": {
            "from": "work.width"
          },
          "height": {
            "from": "work.height"
          },
          "fit": "stretch",
          "method": "bilinear"
        }
      }
    }
  },
