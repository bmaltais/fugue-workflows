{
  "fugue": 1,
  "app": {
    "format": 1,
    "title": "Edit with pictures",
    "description": "Combines pictures by a prompt: each is given to the model as a reference, and the prompt says what to do with them (image 1, image 2 and so on). Pictures 4 and 5 are optional. FLUX.2 Klein 9B.",
    "defaultView": "app",
    "inputs": [
      {
        "role": "prompt",
        "targets": [
          "encode.prompt"
        ],
        "label": "What to do with the pictures"
      },
      {
        "role": "image",
        "name": "image1",
        "targets": [
          "ref1.file"
        ],
        "label": "Picture 1"
      },
      {
        "role": "image",
        "name": "image2",
        "targets": [
          "ref2.file"
        ],
        "label": "Picture 2"
      },
      {
        "role": "image",
        "name": "image3",
        "targets": [
          "ref3.file"
        ],
        "label": "Picture 3"
      },
      {
        "role": "image",
        "name": "image4",
        "targets": [
          "ref4.file"
        ],
        "label": "Picture 4",
        "optional": true
      },
      {
        "role": "image",
        "name": "image5",
        "targets": [
          "ref5.file"
        ],
        "label": "Picture 5",
        "optional": true
      },
      {
        "role": "seed",
        "targets": [
          "sample.seed"
        ],
        "label": "Seed"
      },
      {
        "name": "steps",
        "targets": [
          "sample.steps"
        ],
        "label": "Steps",
        "min": 1,
        "max": 12,
        "section": "Advanced"
      },
      {
        "name": "width",
        "targets": [
          "size.width"
        ],
        "label": "Result width (pixels)",
        "min": 256,
        "max": 2048,
        "section": "Advanced"
      },
      {
        "name": "height",
        "targets": [
          "size.height"
        ],
        "label": "Result height (pixels)",
        "min": 256,
        "max": 2048,
        "section": "Advanced"
      }
    ],
    "outputs": [
      {
        "node": "save",
        "label": "Edited picture"
      }
    ]
  },
  "graph": {
    "nodes": {
      "decode": {
        "inputs": {
          "latent": {
            "from": "sample.latent"
          }
        },
        "type": "fugue/vae-decode",
        "version": "1.0.0"
      },
      "encode": {
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": "Put the cat from image 1 in the armchair from image 2, wearing the red hat from image 3. Keep the room and its lighting as they are.",
          "reference_size": "exact",
          "references": [
            {
              "from": "ref1.image"
            },
            {
              "from": "ref2.image"
            },
            {
              "from": "ref3.image"
            },
            {
              "from": "ref4.image"
            },
            {
              "from": "ref5.image"
            }
          ]
        },
        "type": "fugue/text-encode",
        "version": "1.1.0"
      },
      "models": {
        "inputs": {
          "diffusion_model": {
            "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6",
            "name": "flux-2-klein-9b-Q8_0.gguf",
            "resource": "fugue/diffusion-model"
          },
          "text_encoder": {
            "hash": "sha256:408b955510e196121c1c375201744783b5c9a43c7956d73fc78df54c66e883d6",
            "name": "qwen3/Qwen3-8B-Q8_0.gguf",
            "resource": "fugue/text-encoder"
          },
          "vae": {
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
            "name": "flux2-vae.safetensors",
            "resource": "fugue/vae"
          }
        },
        "type": "fugue/load-models",
        "version": "1.0.0"
      },
      "preview": {
        "inputs": {
          "value": {
            "from": "decode.image"
          }
        },
        "type": "fugue/preview",
        "version": "1.0.0"
      },
      "ref1": {
        "inputs": {
          "file": "inputs/cat.jpg"
        },
        "type": "local/reference-image",
        "version": "1.0.0"
      },
      "ref2": {
        "inputs": {
          "file": "inputs/reading-nook.jpg"
        },
        "type": "local/reference-image",
        "version": "1.0.0"
      },
      "ref3": {
        "inputs": {
          "file": "inputs/beanie.jpg"
        },
        "type": "local/reference-image",
        "version": "1.0.0"
      },
      "ref4": {
        "inputs": {
          "file": "inputs/teacup.jpg"
        },
        "mode": "bypass",
        "type": "local/reference-image",
        "version": "1.0.0"
      },
      "ref5": {
        "inputs": {
          "file": "inputs/fox.jpg"
        },
        "mode": "bypass",
        "type": "local/reference-image",
        "version": "1.0.0"
      },
      "sample": {
        "inputs": {
          "conditioning": {
            "from": "encode.conditioning"
          },
          "flow_shift": 2.02,
          "guidance": 1,
          "latent": {
            "from": "size.latent"
          },
          "model": {
            "from": "models.model"
          },
          "sampler": "euler",
          "scheduler": "discrete",
          "seed": 776,
          "steps": 6
        },
        "type": "fugue/sampler",
        "version": "1.3.0"
      },
      "save": {
        "inputs": {
          "image": {
            "from": "decode.image"
          },
          "name": "{date}/{model}_{time}"
        },
        "type": "fugue/save-image",
        "version": "1.1.0"
      },
      "size": {
        "inputs": {
          "height": 1024,
          "width": 1024
        },
        "type": "fugue/empty-latent",
        "version": "1.0.0"
      }
    }
  },
  "groups": {
    "local/reference-image": {
      "category": "Image/Transform",
      "description": "A picture to give the model as a reference: loaded, then scaled to a megapixel, as ComfyUI's edit does it. Bypass the group to leave the reference out.",
      "inputs": [
        {
          "label": "File",
          "name": "file",
          "targets": [
            "load.file"
          ]
        },
        {
          "label": "Megapixels",
          "name": "megapixels",
          "targets": [
            "scale.megapixels"
          ]
        }
      ],
      "name": "Reference image",
      "nodes": {
        "load": {
          "inputs": {},
          "type": "fugue/load-image",
          "version": "1.1.0"
        },
        "scale": {
          "inputs": {
            "image": {
              "from": "load.image"
            },
            "megapixels": 1,
            "method": "nearest",
            "multiple": 1
          },
          "type": "fugue/resize-megapixels",
          "version": "1.0.0"
        }
      },
      "outputs": [
        {
          "from": "scale.image",
          "label": "Image",
          "name": "image"
        }
      ],
      "version": "1.0.0"
    }
  },
  "layout": {
    "groups": {
      "local/reference-image": {
        "nodes": {
          "load": {
            "pos": [
              0,
              0
            ]
          },
          "scale": {
            "pos": [
              340,
              0
            ]
          }
        }
      }
    },
    "nodes": {
      "decode": {
        "pos": [
          1360,
          0
        ]
      },
      "encode": {
        "pos": [
          680,
          0
        ]
      },
      "models": {
        "pos": [
          0,
          0
        ]
      },
      "preview": {
        "pos": [
          1700,
          0
        ]
      },
      "ref1": {
        "pos": [
          0,
          360
        ]
      },
      "ref2": {
        "pos": [
          0,
          780
        ]
      },
      "ref3": {
        "pos": [
          0,
          1200
        ]
      },
      "ref4": {
        "pos": [
          0,
          1620
        ]
      },
      "ref5": {
        "pos": [
          0,
          2040
        ]
      },
      "sample": {
        "pos": [
          1020,
          0
        ]
      },
      "save": {
        "pos": [
          1700,
          320
        ]
      },
      "size": {
        "pos": [
          680,
          360
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0",
    "models": [
      {
        "resource": "fugue/text-encoder",
        "hash": "sha256:408b955510e196121c1c375201744783b5c9a43c7956d73fc78df54c66e883d6",
        "name": "qwen3/Qwen3-8B-Q8_0.gguf",
        "source": "https://huggingface.co/Qwen/Qwen3-8B-GGUF/resolve/7c41481f57cb95916b40956ab2f0b139b296d974/Qwen3-8B-Q8_0.gguf",
        "size": 8709518112
      },
      {
        "resource": "fugue/diffusion-model",
        "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6",
        "name": "flux-2-klein-9b-Q8_0.gguf",
        "source": "https://huggingface.co/unsloth/FLUX.2-klein-9B-GGUF/resolve/6db9b2d0479c98795589c94c9beef5cc818c6966/flux-2-klein-9b-Q8_0.gguf",
        "size": 10245691680
      },
      {
        "resource": "fugue/vae",
        "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
        "name": "flux2-vae.safetensors",
        "source": "https://huggingface.co/Comfy-Org/Flux-2-Dev/resolve/9630c1b4b6e690497ae0c19bb6b1b35d4ebedcb7/split_files/vae/flux2-vae.safetensors",
        "size": 336213556
      }
