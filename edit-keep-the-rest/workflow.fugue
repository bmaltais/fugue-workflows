          },
          "guidance": 1,
          "latent": {
            "from": "size.latent"
          },
          "model": {
            "from": "models.model"
          },
          "sampler": "euler",
          "seed": 11,
          "steps": 4
        },
        "type": "fugue/sampler",
        "version": "1.0.0"
      },
      "save": {
        "inputs": {
          "image": {
            "from": "keep.image"
          },
          "name": "edit-keep-the-rest"
        },
        "type": "fugue/save-image",
        "version": "1.0.0"
      },
      "scale": {
        "inputs": {
          "image": {
            "from": "load.image"
          },
          "megapixels": 1,
          "method": "lanczos"
        },
        "type": "fugue/resize-megapixels",
        "version": "1.0.0"
      },
      "size": {
        "inputs": {
          "height": {
            "from": "scale.height"
          },
          "width": {
            "from": "scale.width"
          }
        },
        "type": "fugue/empty-latent",
        "version": "1.0.0"
      },
      "keep": {
        "type": "fugue/keep-unchanged",
        "version": "1.0.0",
        "inputs": {
          "original": {
            "from": "load.image"
          },
          "edited": {
            "from": "decode.image"
          },
          "blur": 4,
          "threshold": 0.12,
          "speck": 12,
          "close": 24,
          "margin": 16,
          "feather": 16
        }
      },
      "mask_preview": {
        "type": "fugue/preview",
        "version": "1.0.0",
        "inputs": {
          "value": {
            "from": "keep.mask"
          }
        }
      }
    }
  },
