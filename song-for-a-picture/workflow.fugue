{
  "fugue": 1,
  "graph": {
    "nodes": {
      "picture": {
        "inputs": {
          "file": "inputs/dusk.jpg"
        },
        "type": "fugue/load-image",
        "version": "1.1.0"
      },
      "look": {
        "inputs": {
          "image": {
            "from": "picture.image"
          },
          "style": "song-prompt",
          "seed": {
            "auto": "random"
          }
        },
        "type": "fugue/describe-image",
        "version": "1.0.0"
      },
      "song": {
        "inputs": {
          "prompt": {
            "from": "look.text"
          },
          "instrumental": true,
          "duration": 45,
          "seed": {
            "auto": "random"
          }
        },
        "type": "fugue/generate-song",
        "version": "1.1.0"
      },
      "save": {
        "inputs": {
          "audio": {
            "from": "song.audio"
          },
          "name": "picture-song"
        },
        "type": "fugue/save-audio",
        "version": "1.0.0"
      }
    }
  },
  "layout": {
    "nodes": {
      "picture": {
        "pos": [
          0,
          0
        ]
      },
      "look": {
        "pos": [
          400,
          0
        ]
      },
      "song": {
        "pos": [
          820,
          0
        ]
      },
      "save": {
        "pos": [
          1240,
          0
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0"
  }
}
