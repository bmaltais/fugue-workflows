{
  "fugue": 1,
  "graph": {
    "nodes": {
      "song": {
        "inputs": {
          "file": "inputs/sample.mp3"
        },
        "type": "fugue/load-audio",
        "version": "1.0.0"
      },
      "remix": {
        "inputs": {
          "audio": {
