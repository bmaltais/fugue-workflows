{
  "fugue": 1,
  "action": {
    "name": "Upscale (no model)",
    "description": "Makes the whole picture 2 or 4 times bigger with plain Lanczos resampling, no model and nothing to download. It adds no detail: it is the quick, offline choice. The result is a new canvas; the original is untouched.",
    "glyph": "zoom-in",
    "selection": "none",
    "format": 1,
    "region": "region",
    "inputs": [
      {
        "name": "scale",
        "targets": [
          "wide.b",
          "tall.b"
        ],
        "label": "Scale",
        "section": "Advanced",
        "choices": [
          "2x",
          "4x"
        ],
        "choice_values": [
          2,
          4
        ],
        "default": "2x"
      }
    ]
  },
  "graph": {
    "nodes": {
      "region": {
        "type": "fugue/canvas-region",
        "version": "1.4.0",
        "inputs": {
          "canvas": "",
          "revision": "head",
          "layer": "",
          "x": 0,
          "y": 0,
          "width": 0,
          "height": 0,
          "padding": 0,
          "scale": 1,
          "max_megapixels": 0,
          "feather": 0,
          "multiple": 1
        }
      },
      "wide": {
        "type": "fugue/number-math",
        "version": "1.0.0",
        "inputs": {
          "a": {
            "from": "region.width"
          },
          "operation": "multiply",
          "b": 2
        }
      },
      "tall": {
        "type": "fugue/number-math",
        "version": "1.0.0",
        "inputs": {
          "a": {
            "from": "region.height"
          },
          "operation": "multiply",
          "b": 2
        }
      },
      "size": {
        "type": "fugue/resize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "region.image"
          },
          "width": {
            "from": "wide.value"
          },
          "height": {
            "from": "tall.value"
          },
          "fit": "stretch",
          "method": "lanczos"
        }
      },
      "new": {
        "type": "fugue/canvas-new",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "size.image"
          },
          "name": "Upscaled"
        }
      }
    }
  },
  "layout": {
    "nodes": {
      "region": {
        "pos": [
          0,
          0
        ]
      },
      "wide": {
        "pos": [
          380,
          520
        ]
      },
      "tall": {
        "pos": [
          380,
          800
        ]
      },
      "size": {
        "pos": [
          760,
          0
        ]
      },
      "new": {
        "pos": [
          1140,
          0
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0"
  }
}
