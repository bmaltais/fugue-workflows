  "app": {
    "format": 1,
    "title": "Retro Game Title Screen",
    "description": "Type a title, a scene and a hero: out comes an 8-bit arcade title screen.",
    "defaultView": "app",
    "inputs": [
      {
        "name": "title",
        "targets": [
          "title.text"
        ],
        "label": "Game title"
      },
      {
        "role": "prompt",
        "name": "scene",
        "targets": [
          "encode_scene.prompt"
        ],
        "label": "Scene",
        "default": "a neon-lit alien city at night under a huge purple moon, flying cars, glowing signs, rain-slick streets, retro sci-fi arcade game background, wide shot, empty street in the foreground"
      },
      {
        "name": "hero",
        "targets": [
          "hero_prompt.a"
        ],
        "label": "Hero",
        "default": "a heroic cartoon space ranger in a bright red and orange armored suit with a round helmet and a blue glowing visor, holding a big blaster"
      },
      {
        "role": "seed",
        "targets": [
          "sample_scene.seed",
          "sample_hero.seed"
        ],
        "label": "Seed"
      },
      {
        "name": "variation",
        "targets": [
          "sample_scene.variation_strength",
          "sample_hero.variation_strength"
        ],
        "label": "Variation (small redraws of a screen you like)",
        "min": 0,
        "max": 1,
        "section": "Advanced"
      },
      {
        "name": "pixel",
        "targets": [
          "pixels.block_size"
        ],
        "label": "Pixel size",
        "min": 1,
        "max": 24,
        "section": "Advanced"
      },
      {
        "name": "levels",
        "targets": [
          "posterize.levels"
        ],
        "label": "Color levels",
        "min": 2,
        "max": 16,
        "section": "Advanced"
      }
    ],
    "outputs": [
      {
        "node": "save",
        "label": "Title screen"
      }
    ]
  }
