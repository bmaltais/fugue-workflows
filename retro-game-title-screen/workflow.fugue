{
  "fugue": 1,
  "graph": {
    "nodes": {
      "models": {
        "type": "fugue/load-models",
        "version": "1.2.0",
        "inputs": {
          "diffusion_model": {
            "hash": "sha256:be517ebd47c912a5626a588e1aeea43e6be4a43c0cdcd2b48a2a780d9f358635",
            "name": "z_image_turbo_int8_convrot.safetensors",
            "resource": "fugue/diffusion-model"
          },
          "text_encoder": {
            "hash": "sha256:8c2f07f26af9747e41988551106f149b03eb9b5cb6df636027b6bf6278473300",
            "name": "qwen3/Qwen3-4B-Q8_0.gguf",
            "resource": "fugue/text-encoder"
          },
          "vae": {
            "hash": "sha256:afc8e28272cd15db3919bacdb6918ce9c1ed22e96cb12c4d5ed0fba823529e38",
            "name": "ae.safetensors",
            "resource": "fugue/vae"
          }
        }
      },
      "encode_scene": {
        "type": "fugue/text-encode",
        "version": "1.1.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": "a neon-lit alien city at night under a huge purple moon, flying cars, glowing signs, rain-slick streets, retro sci-fi arcade game background, wide shot, empty street in the foreground"
        }
      },
      "hero_prompt": {
        "type": "fugue/text-template",
        "version": "1.0.0",
        "inputs": {
          "template": "{a}, full body, standing, front view, solid plain flat bright pure green (#00ff00) background, no shadow",
          "a": "a heroic cartoon space ranger in a bright red and orange armored suit with a round helmet and a blue glowing visor, holding a big blaster"
        }
      },
      "encode_hero": {
        "type": "fugue/text-encode",
        "version": "1.1.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": {
            "from": "hero_prompt.text"
          }
        }
      },
      "size": {
        "type": "fugue/empty-latent",
        "version": "1.0.0",
        "inputs": {
          "width": 1024,
          "height": 1024
        }
      },
      "sample_scene": {
        "type": "fugue/sampler",
        "version": "1.5.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "conditioning": {
            "from": "encode_scene.conditioning"
          },
          "latent": {
            "from": "size.latent"
          },
          "guidance": 1,
          "steps": 8,
          "seed": {
            "auto": "random"
          }
        }
      },
      "sample_hero": {
        "type": "fugue/sampler",
        "version": "1.5.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "conditioning": {
            "from": "encode_hero.conditioning"
          },
          "latent": {
            "from": "size.latent"
          },
          "guidance": 1,
          "steps": 8,
          "seed": {
            "auto": "random"
          },
          "variation_strength": 0
        }
      },
      "scene": {
        "type": "fugue/vae-decode",
        "version": "1.0.0",
        "inputs": {
          "latent": {
            "from": "sample_scene.latent"
          }
        }
      },
      "hero": {
        "type": "fugue/vae-decode",
        "version": "1.0.0",
        "inputs": {
          "latent": {
            "from": "sample_hero.latent"
          }
        }
      },
      "key": {
        "type": "fugue/mask-from-color",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "hero.image"
          },
          "color": "#65e478",
          "tolerance": 0.14,
          "soften": 3
        }
      },
      "match": {
        "type": "fugue/color-match",
        "version": "1.1.0",
        "inputs": {
          "image": {
            "from": "hero.image"
          },
          "reference": {
            "from": "scene.image"
          },
          "mask": {
            "from": "key.mask"
          },
          "method": "match-color",
          "strength": 0.65,
          "luminance": 0.7,
          "color_intensity": 1.1
        }
      },
      "cut": {
        "type": "fugue/invert-mask",
        "version": "1.0.1",
        "inputs": {
          "mask": {
            "from": "key.mask"
          }
        }
      },
      "small": {
        "type": "fugue/resize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "match.image"
          },
          "width": 800,
          "height": 800,
          "fit": "contain"
        }
      },
      "small_mask": {
        "type": "fugue/resize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "cut.mask"
          },
          "width": 800,
          "height": 800,
          "fit": "contain"
        }
      },
      "place": {
        "type": "fugue/composite-masked",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "scene.image"
          },
          "source": {
            "from": "small.image"
          },
          "mask": {
            "from": "small_mask.image"
          },
          "x": 112,
          "y": 244
        }
      },
      "posterize": {
        "type": "fugue/posterize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "place.image"
          },
          "levels": 7
        }
      },
      "grade": {
        "type": "fugue/apply-lut",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "posterize.image"
          },
          "file": "inputs/neon-arcade.cube",
          "strength": 1
        }
      },
      "title": {
        "type": "fugue/draw-text",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "grade.image"
          },
          "text": "SPACE RANGER",
          "anchor": "top-center",
          "x": 512,
          "y": 70,
          "size": 120,
          "color": "#ffe81a",
          "outline": 10,
          "outline_color": "#2a0050",
          "align": "center",
          "max_width": 980
        }
      },
      "start": {
        "type": "fugue/draw-text",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "title.image"
          },
          "text": "PRESS START",
          "anchor": "bottom-center",
          "x": 512,
          "y": 979,
          "size": 72,
          "color": "#ffffff",
          "outline": 9,
          "outline_color": "#2a0050"
        }
      },
      "pixels": {
        "type": "fugue/pixelize",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "start.image"
          },
          "block_size": 7
        }
      },
      "preview": {
        "type": "fugue/preview",
        "version": "1.0.0",
        "inputs": {
          "value": {
            "from": "pixels.image"
          }
        }
      },
      "save": {
        "type": "fugue/save-image",
        "version": "1.1.0",
        "inputs": {
          "image": {
            "from": "pixels.image"
          },
          "name": "retro-title-screen"
        }
      }
    }
  },
