  },
  "requires": {
    "fugue": "0.1.0",
    "models": [
      {
        "hash": "sha256:32de113cbf8282b02cbff0794b637b9d6676da09314a1db5a30bcea9bf4ee01c",
        "name": "qwen3vl_4b_int8_convrot.safetensors",
        "resource": "fugue/text-encoder",
        "size": 4858559240,
        "source": "https://huggingface.co/Comfy-Org/Krea-2/resolve/588feaf955b08b9ac4723eeb751752ab045dba71/text_encoders/qwen3vl_4b_int8_convrot.safetensors"
      },
      {
        "hash": "sha256:8e4eeda70dd5037ab1ba2bef6b417f9f901e26093117cf397f741fc1fdaaf3f1",
