 "groups": {
  "local/krea2-edit": {
   "version": "1.0.0",
   "name": "Krea 2 Edit",
   "category": "Image/Edit",
   "description": "Edits a picture from a plain instruction with Krea 2 Turbo and a Krea 2 Edit LoRA (Identity Edit or General Edit, V2): 8 steps, euler, simple, guidance 1. The picture goes to the model twice, as the text encoder's vision input and as clean reference tokens, in the layout the LoRAs were trained on (Text Encode's edit format Krea 2 Edit, ported from the ComfyUI-Krea2Edit pack, Apache-2.0, github.com/lbouaraba/comfyui-krea2edit). Reference boost sets how hard the output copies the picture, Reference placement whether it is pinned on the output's layout (aligned, for edits) or beside it (to restage a person). Use one Edit LoRA at a time. Removals want Krea 2 Raw at guidance 3 and about 20 steps. Keep the output at 2 megapixels or less. Licences: the Edit LoRAs (V2) are free for personal and non-commercial use only; commercial use needs a licence from their author (https://huggingface.co/conradlocke/krea2-identity-edit/blob/main/LICENSE_V2.md), and the Krea 2 Community License applies on top (commercial use only under USD 1 M yearly revenue; deployments must filter content; https://krea.ai/krea-2-licensing).",
   "inputs": [
    {
     "name": "image",
     "label": "Picture",
     "targets": [
      "encode.references"
     ]
    },
    {
     "name": "prompt",
     "label": "Instruction",
     "targets": [
      "encode.prompt"
     ]
    },
    {
     "name": "width",
     "label": "Width",
     "targets": [
      "size.width"
     ]
    },
    {
     "name": "height",
     "label": "Height",
     "targets": [
      "size.height"
     ]
    },
    {
     "name": "seed",
     "label": "Seed",
     "targets": [
      "sample.seed"
     ]
    },
    {
     "name": "lora",
     "label": "Edit LoRA",
     "targets": [
      "edit.lora"
     ]
    },
    {
     "name": "strength",
     "label": "LoRA strength",
     "default": 1,
     "targets": [
      "edit.strength"
     ]
    },
    {
     "name": "ref_boost",
     "label": "Reference boost",
     "default": 4,
     "targets": [
      "encode.ref_boost"
     ]
    },
    {
     "name": "ref_position",
     "label": "Reference placement",
     "default": "aligned",
     "targets": [
      "encode.ref_position"
     ]
    },
    {
     "name": "diffusion_model",
     "label": "Diffusion model",
     "targets": [
      "models.diffusion_model"
     ]
    },
    {
     "name": "text_encoder",
     "label": "Text encoder",
     "targets": [
      "models.text_encoder"
     ]
    },
    {
     "name": "vae",
     "label": "VAE",
     "targets": [
      "models.vae"
     ]
    },
    {
     "name": "vision_size",
     "label": "Vision size",
     "default": 768,
     "section": "Advanced",
     "targets": [
      "encode.vision_size"
     ]
    },
    {
     "name": "steps",
     "label": "Steps",
     "default": 8,
     "section": "Advanced",
     "targets": [
      "sample.steps"
     ]
    },
    {
     "name": "guidance",
     "label": "Guidance",
     "default": 1,
     "section": "Advanced",
     "targets": [
      "sample.guidance"
     ]
    }
   ],
   "outputs": [
    {
     "name": "image",
     "label": "Image",
     "from": "decode.image"
    }
   ],
   "nodes": {
    "models": {
     "type": "fugue/load-models",
     "version": "1.4.0",
     "inputs": {}
    },
    "edit": {
     "type": "fugue/apply-lora",
     "version": "1.0.0",
     "inputs": {
      "model": {
       "from": "models.model"
      }
     }
    },
    "encode": {
     "type": "fugue/text-encode",
     "version": "1.3.0",
     "inputs": {
      "model": {
       "from": "edit.model"
      },
      "edit_format": "Krea 2 Edit"
     }
    },
    "size": {
     "type": "fugue/empty-latent",
     "version": "1.0.0",
     "inputs": {}
    },
    "sample": {
     "type": "fugue/sampler",
     "version": "1.5.0",
     "inputs": {
      "model": {
       "from": "edit.model"
      },
      "conditioning": {
       "from": "encode.conditioning"
      },
      "latent": {
       "from": "size.latent"
      },
      "sampler": "euler",
      "scheduler": "simple",
      "denoise": 1
     }
    },
    "decode": {
     "type": "fugue/vae-decode",
     "version": "1.0.0",
     "inputs": {
      "latent": {
       "from": "sample.latent"
      }
     }
    }
   }
  }
 },
