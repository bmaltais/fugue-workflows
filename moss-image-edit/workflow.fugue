          720
        ]
      },
      "size": {
        "pos": [
          680,
          720
        ]
      },
      "encode": {
        "pos": [
          680,
          0
        ]
      },
      "sample": {
        "pos": [
          1020,
          0
        ]
      },
      "decode": {
        "pos": [
          1360,
          0
        ]
      },
      "save": {
        "pos": [
          1700,
          0
        ]
      },
      "compare": {
        "pos": [
          1700,
          720
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0",
    "models": [
      {
        "resource": "fugue/diffusion-model",
        "name": "moss_image_sft_int8_convrot.safetensors",
        "hash": "sha256:b4d1475bc7eeffd7b809e82ea13a1fba1fb85c4e18365af3813722faa5c0fe4f",
        "source": "https://huggingface.co/Comfy-Org/MOSS-Image/resolve/2929efe3cdd506c0a430bcfca70a9a8d805cc095/diffusion_models/moss_image_sft_int8_convrot.safetensors",
        "size": 5413698958
      },
      {
        "resource": "fugue/text-encoder",
        "name": "qwen3.5_9b_int8_convrot.safetensors",
        "hash": "sha256:32e3787472f708fa5f83624acbf5ef23f7fc89c439e05065ea57cfe5a97f025a",
        "source": "https://huggingface.co/Comfy-Org/MOSS-Image/resolve/2929efe3cdd506c0a430bcfca70a9a8d805cc095/text_encoders/qwen3.5_9b_int8_convrot.safetensors",
        "size": 9748121532
