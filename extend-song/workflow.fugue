{
  "fugue": 1,
  "graph": {
    "nodes": {
      "song": {
        "type": "fugue/load-audio",
        "version": "1.0.0",
        "inputs": {
          "file": "inputs/sample.mp3"
        }
      },
      "extend": {
        "type": "fugue/extend-song",
        "version": "1.0.0",
        "inputs": {
          "audio": {
            "from": "song.audio"
          },
          "prompt": "warm acoustic folk, fingerpicked guitar, gentle and unhurried, the same song carried on to a calm ending",
          "instrumental": true,
          "before": 0,
          "after": 12,
          "seed": {
            "auto": "random"
          }
        }
      },
      "save": {
        "type": "fugue/save-audio",
        "version": "1.0.0",
        "inputs": {
          "audio": {
            "from": "extend.audio"
          },
          "name": "extended"
        }
      }
    }
  },
  "layout": {
    "nodes": {
      "song": {
        "pos": [
          0,
          0
        ]
      },
      "extend": {
        "pos": [
          400,
          0
        ]
      },
      "save": {
        "pos": [
          820,
          0
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0"
  }
}
