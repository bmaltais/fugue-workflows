        "version": "1.0.0"
      },
      "inpaint": {
        "type": "fugue/inpaint-crop-stitch",
        "version": "1.1.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "image": {
            "from": "load.image"
          },
          "mask": {
            "from": "load.mask"
          },
          "prompt": "A mustard yellow velvet armchair with a soft cushion, in the same lamplight.",
          "seed": {
            "auto": "random"
          },
          "steps": 4,
          "guidance": 1,
          "denoise": 1,
          "padding": 64,
          "megapixels": 1,
