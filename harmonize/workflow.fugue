        "hash": "sha256:8c2f07f26af9747e41988551106f149b03eb9b5cb6df636027b6bf6278473300",
        "name": "qwen3/Qwen3-4B-Q8_0.gguf",
        "source": "https://huggingface.co/Qwen/Qwen3-4B-GGUF/resolve/bc640142c66e1fdd12af0bd68f40445458f3869b/Qwen3-4B-Q8_0.gguf",
