{
  "fugue": 1,
  "action": {
    "name": "Harmonize",
    "description": "Makes a pasted-together picture look like one photograph: one light, one grade, one grain. Select the pasted parts, or select nothing for the whole picture.",
    "glyph": "wand",
    "selection": "optional",
    "format": 1,
    "region": "region",
    "inputs": [
      {
        "role": "prompt",
        "targets": [
          "prompt_join.b"
        ],
        "label": "Prompt",
        "optional": true
      },
      {
        "role": "seed",
        "targets": [
          "sample.seed"
        ]
      },
      {
        "role": "strength",
        "targets": [
          "sample.denoise"
        ],
        "default": 1,
        "min": 0.3,
        "max": 1,
        "section": "Advanced"
      },
      {
        "role": "model",
        "targets": [
          "models.diffusion_model"
        ],
        "section": "Advanced"
      },
      {
        "name": "pasted_boost",
        "targets": [
          "pasted_level.value"
        ],
        "label": "Pasted areas",
        "default": 0.25,
        "min": 0,
        "max": 0.5,
        "section": "Advanced"
      },
      {
        "name": "whole_picture",
        "targets": [
          "base_level.value"
        ],
        "label": "Whole picture",
        "default": 0.5,
        "min": 0,
        "max": 0.75,
        "section": "Advanced"
      },
      {
        "name": "steps",
        "targets": [
          "sample.steps"
        ],
        "label": "Steps",
        "section": "Advanced"
      }
    ]
  },
  "graph": {
    "nodes": {
      "models": {
        "type": "fugue/load-models",
        "version": "1.0.0",
        "inputs": {
          "diffusion_model": {
            "resource": "fugue/diffusion-model",
            "name": "flux-2-klein-4b-fp8.safetensors",
            "hash": "sha256:97ed34fe0567e436200f2faee3939b88f2b5d99f8af2a4dc16532c4245c0ccb6"
          },
          "text_encoder": {
            "resource": "fugue/text-encoder",
            "name": "qwen3/Qwen3-4B-Q8_0.gguf",
            "hash": "sha256:8c2f07f26af9747e41988551106f149b03eb9b5cb6df636027b6bf6278473300"
          },
          "vae": {
            "resource": "fugue/vae",
            "name": "flux2-vae.safetensors",
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5"
          }
        }
      },
      "region": {
        "type": "fugue/canvas-region",
        "version": "1.2.0",
        "inputs": {
          "canvas": "",
          "revision": "head",
          "x": 0,
          "y": 0,
          "width": 0,
          "height": 0,
          "padding": 64,
          "scale": 1,
          "max_megapixels": 1,
          "feather": 0,
          "multiple": 16
        }
      },
      "outer": {
        "type": "fugue/grow-mask",
        "version": "1.0.1",
        "inputs": {
          "mask": {
            "from": "region.mask"
          },
          "expand": 48,
          "tapered_corners": true
        }
      },
      "inner": {
        "type": "fugue/grow-mask",
        "version": "1.0.1",
        "inputs": {
          "mask": {
            "from": "region.mask"
          },
          "expand": -48,
          "tapered_corners": true
        }
      },
      "seam": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "outer.mask"
          },
          "source": {
            "from": "inner.mask"
          },
          "operation": "subtract"
        }
      },
      "pasted_level": {
        "type": "fugue/solid-mask",
        "version": "1.0.1",
        "inputs": {
          "value": 0.25,
          "width": {
            "from": "region.width"
          },
          "height": {
            "from": "region.height"
          }
        }
      },
      "pasted": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "inner.mask"
          },
          "source": {
            "from": "pasted_level.mask"
          },
          "operation": "multiply"
        }
      },
      "seam_pasted": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "seam.mask"
          },
          "source": {
            "from": "pasted.mask"
          },
          "operation": "add"
        }
      },
      "base_level": {
        "type": "fugue/solid-mask",
        "version": "1.0.1",
        "inputs": {
          "value": 0.5,
          "width": {
            "from": "region.width"
          },
          "height": {
            "from": "region.height"
          }
        }
      },
      "strength_map": {
        "type": "fugue/combine-masks",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "seam_pasted.mask"
          },
          "source": {
            "from": "base_level.mask"
          },
          "operation": "add"
        }
      },
      "soft": {
        "type": "fugue/blur",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "region.image"
          },
          "radius": 30,
          "sigma": 1.0
        }
      },
      "seamed": {
        "type": "fugue/composite-masked",
        "version": "1.0.0",
        "inputs": {
          "destination": {
            "from": "region.image"
          },
          "source": {
            "from": "soft.image"
          },
          "mask": {
            "from": "seam.mask"
          },
          "x": 0,
          "y": 0,
          "resize_source": false
        }
      },
      "prompt_join": {
        "type": "fugue/text-concat",
        "version": "1.0.0",
        "inputs": {
          "a": "Make this one photograph: blend any pasted part into the scene and remove hard edges and halos, and make the light direction, colour temperature, shadows, sharpness and grain consistent across the whole picture. Keep every object, person and face unchanged.",
          "b": "",
          "separator": " "
        }
      },
      "encode": {
        "type": "fugue/text-encode",
        "version": "1.0.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": {
            "from": "prompt_join.text"
          },
          "references": [
            {
              "from": "seamed.image"
            }
          ]
        }
      },
      "vae_encode": {
        "type": "fugue/vae-encode",
        "version": "1.1.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "image": {
            "from": "seamed.image"
          },
          "mask": {
            "from": "strength_map.mask"
          }
        }
      },
      "sample": {
        "type": "fugue/sampler",
        "version": "1.2.0",
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "conditioning": {
            "from": "encode.conditioning"
          },
          "latent": {
            "from": "vae_encode.latent"
          },
          "seed": {
            "auto": "random"
          },
          "steps": 4,
          "guidance": 1,
          "denoise": 1,
          "soft_mask": true
        }
      },
      "decode": {
        "type": "fugue/vae-decode",
        "version": "1.0.0",
        "inputs": {
          "latent": {
            "from": "sample.latent"
          }
        }
      },
      "match": {
        "type": "fugue/color-match",
        "version": "1.0.0",
        "inputs": {
          "image": {
            "from": "decode.image"
          },
          "reference": {
            "from": "region.image"
          },
          "strength": 1
        }
      },
      "write": {
        "type": "fugue/canvas-write",
        "version": "1.3.0",
        "inputs": {
          "canvas": {
            "from": "region.canvas"
          },
          "image": {
            "from": "match.image"
          },
          "stitch": {
            "from": "region.stitch"
          },
          "blend": 16,
          "name": "Harmonized"
        }
      },
      "preview": {
        "type": "fugue/preview",
        "version": "1.0.0",
        "inputs": {
          "value": {
            "from": "match.image"
          }
        }
      }
    }
  },
  "layout": {
    "nodes": {
      "models": {
        "pos": [
          0,
