  "requires": {
    "fugue": "0.1.0",
    "models": [
      {
        "resource": "fugue/diffusion-model",
        "hash": "sha256:97ed34fe0567e436200f2faee3939b88f2b5d99f8af2a4dc16532c4245c0ccb6",
        "name": "flux-2-klein-4b-fp8.safetensors",
        "source": "https://huggingface.co/black-forest-labs/FLUX.2-klein-4b-fp8/resolve/5b4408e59397a4a37ccb46afe426d8ed86379441/flux-2-klein-4b-fp8.safetensors",
        "size": 4070624520
