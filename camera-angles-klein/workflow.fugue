{
 "fugue": 1,
 "app": {
  "format": 1,
  "title": "Camera Angles (FLUX.2 Klein 9B)",
  "description": "Makes six views of your picture from different camera positions, asked for in plain words, and a labelled sheet of all six. Lighter and faster than Camera Angles, with less exact angles.",
  "defaultView": "app",
  "inputs": [
   {
    "role": "image",
    "name": "picture",
    "targets": [
     "load.file"
    ],
    "label": "Your picture"
   },
   {
    "role": "seed",
    "targets": [
     "sample_turn-right.seed",
     "sample_side-profile.seed",
     "sample_back.seed",
     "sample_low-angle.seed",
     "sample_from-above.seed",
     "sample_close-up.seed"
    ],
    "label": "Seed"
   }
  ],
  "outputs": [
   {
    "node": "save_grid",
    "label": "All views"
   },
   {
    "node": "save_turn-right",
    "label": "Turned right"
   },
   {
    "node": "save_side-profile",
    "label": "Side profile"
   },
   {
    "node": "save_back",
    "label": "Back"
   },
   {
    "node": "save_low-angle",
    "label": "Low angle"
   },
   {
    "node": "save_from-above",
    "label": "From above"
   },
   {
    "node": "save_close-up",
    "label": "Close-up"
   }
  ]
 },
 "graph": {
  "nodes": {
   "models": {
    "type": "fugue/load-models",
    "version": "1.2.0",
    "inputs": {
     "text_encoder": {
      "resource": "fugue/text-encoder",
      "name": "qwen3/Qwen3-8B-Q8_0.gguf",
      "hash": "sha256:408b955510e196121c1c375201744783b5c9a43c7956d73fc78df54c66e883d6"
     },
     "diffusion_model": {
      "resource": "fugue/diffusion-model",
      "name": "flux-2-klein-9b-Q8_0.gguf",
      "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6"
     },
     "vae": {
      "resource": "fugue/vae",
      "name": "flux2-vae.safetensors",
      "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5"
     }
    }
   },
   "load": {
    "type": "fugue/load-image",
    "version": "1.1.0",
    "inputs": {
     "file": "inputs/cat.jpg"
    }
   },
   "rs": {
    "type": "fugue/resize-megapixels",
    "version": "1.0.0",
    "inputs": {
     "image": {
      "from": "load.image"
     },
     "megapixels": 1
    }
   },
   "size": {
    "type": "fugue/empty-latent",
    "version": "1.0.0",
    "inputs": {
     "width": {
      "from": "rs.width"
     },
     "height": {
      "from": "rs.height"
     }
    }
   },
   "enc_turn-right": {
    "type": "fugue/text-encode",
    "version": "1.1.0",
    "inputs": {
     "model": {
      "from": "models.model"
     },
     "prompt": "Rotate the camera 45 degrees to the right around the subject. Same subject, same scene, same lighting.",
     "reference_size": "exact",
     "references": [
      {
       "from": "rs.image"
      }
     ]
    }
   },
   "sample_turn-right": {
    "type": "fugue/sampler",
    "version": "1.5.0",
    "inputs": {
     "model": {
      "from": "models.model"
     },
     "conditioning": {
      "from": "enc_turn-right.conditioning"
     },
     "latent": {
      "from": "size.latent"
     },
     "seed": 776,
     "steps": 6,
     "guidance": 1,
     "flow_shift": 2.02,
     "sampler": "euler",
     "scheduler": "discrete"
    }
   },
   "decode_turn-right": {
    "type": "fugue/vae-decode",
    "version": "1.0.0",
    "inputs": {
     "latent": {
      "from": "sample_turn-right.latent"
     }
    }
   },
   "save_turn-right": {
    "type": "fugue/save-image",
    "version": "1.1.0",
    "inputs": {
     "image": {
      "from": "decode_turn-right.image"
     },
     "name": "camera-angles-klein/turn-right"
    }
   },
   "enc_side-profile": {
    "type": "fugue/text-encode",
    "version": "1.1.0",
    "inputs": {
     "model": {
      "from": "models.model"
     },
     "prompt": "Rotate the camera 90 degrees to the right so we see the subject in side profile. Same subject, same scene, same lighting.",
     "reference_size": "exact",
     "references": [
      {
       "from": "rs.image"
      }
     ]
    }
   },
   "sample_side-profile": {
    "type": "fugue/sampler",
    "version": "1.5.0",
    "inputs": {
