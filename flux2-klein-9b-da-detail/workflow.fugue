{
  "fugue": 1,
  "app": {
    "format": 1,
    "title": "Detailer",
    "description": "Finds the faces and the eyes in a picture, redraws each at the model's full detail and puts them back through a soft edge (FLUX.2 Klein 9B). Needs the Segment pack.",
    "defaultView": "app",
    "inputs": [
      {
        "role": "image",
        "targets": [
          "load.file"
        ],
        "label": "Picture"
      },
      {
        "role": "prompt",
        "targets": [
          "encode.prompt"
        ],
        "label": "What the detail looks like"
      },
      {
        "role": "seed",
        "targets": [
          "detail.seed"
        ],
        "label": "Seed"
      },
      {
        "name": "face_denoise",
        "targets": [
          "detail.face_denoise"
        ],
        "label": "How much to redraw faces",
        "min": 0,
        "max": 1,
        "section": "Advanced",
        "default": 0.3
      },
      {
        "name": "eyes_denoise",
        "targets": [
          "detail.eyes_denoise"
        ],
        "label": "How much to redraw eyes",
        "min": 0,
        "max": 1,
        "section": "Advanced",
        "default": 0.35
      }
    ],
    "outputs": [
      {
        "node": "save",
        "label": "Detailed picture"
      }
    ]
  },
  "graph": {
    "nodes": {
      "compare": {
        "inputs": {
          "a": {
            "from": "load.image"
          },
          "b": {
            "from": "detail.image"
          },
          "mode": "slider"
        },
        "type": "fugue/compare-images",
        "version": "1.0.0"
      },
      "detail": {
        "inputs": {
          "conditioning": {
            "from": "encode.conditioning"
          },
          "detector": {
            "hash": "sha256:04c18d2db35569f11c47732f2e05ed3a71559a8903823fc581e90b0e3168c9ff",
            "name": "grounding-dino-tiny_fp16.onnx",
            "resource": "io.github.bmaltais.fugue-segment/grounding-dino-model"
          },
          "image": {
            "from": "load.image"
          },
          "model": {
            "from": "models.model"
          },
          "seed": 776
        },
        "type": "local/face-and-eye-detailer",
        "version": "1.0.0"
      },
      "encode": {
        "inputs": {
          "model": {
            "from": "models.model"
          },
          "prompt": "a sharp, natural photograph with fine detail, realistic skin texture and clear, well-defined eyes"
        },
        "type": "fugue/text-encode",
        "version": "1.0.0"
      },
      "load": {
        "inputs": {
          "file": "inputs/two-people.jpg"
        },
        "type": "fugue/load-image",
        "version": "1.1.0"
      },
      "models": {
        "inputs": {
          "diffusion_model": {
            "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6",
            "name": "flux-2-klein-9b-Q8_0.gguf",
            "resource": "fugue/diffusion-model"
          },
          "text_encoder": {
            "hash": "sha256:0cfbf745760f07a76ddeb358dd025a27f2e11d1ca9c9a4169a373d52990fe86e",
            "name": "Qwen3-8B-Q8_0.gguf",
            "resource": "fugue/text-encoder"
          },
          "vae": {
            "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
            "name": "flux2-vae.safetensors",
            "resource": "fugue/vae"
          }
        },
        "type": "fugue/load-models",
        "version": "1.0.0"
      },
      "save": {
        "inputs": {
          "image": {
            "from": "detail.image"
          },
          "name": "{date}/{model}_{time}"
        },
        "type": "fugue/save-image",
        "version": "1.1.0"
      }
    }
  },
  "groups": {
    "local/face-and-eye-detailer": {
      "category": "Image/Transform",
      "description": "Redraws every face, then every eye, at the model's full detail and puts each back through a soft edge. Find by Text names the faces and the eyes in the incoming picture (both from the same picture, as the DA workflow detects them), and Detail Regions refines them in turn. Drop it after any template that makes a picture.",
      "inputs": [
        {
          "label": "Image",
          "name": "image",
          "targets": [
            "find_face.image",
            "find_eyes.image",
            "face_pass.image"
          ]
        },
        {
          "label": "Model",
          "name": "model",
          "targets": [
            "face_pass.model",
            "eyes_pass.model"
          ]
        },
        {
          "label": "Prompt",
          "name": "conditioning",
          "targets": [
            "face_pass.conditioning",
            "eyes_pass.conditioning"
          ]
        },
        {
          "label": "Detector",
          "name": "detector",
          "targets": [
            "find_face.model",
            "find_eyes.model"
          ]
        },
        {
          "label": "Seed",
          "name": "seed",
          "targets": [
            "face_pass.seed",
            "eyes_pass.seed"
          ]
        },
        {
          "label": "Face query",
          "name": "face_query",
          "section": "Faces",
          "targets": [
            "find_face.query"
          ]
        },
        {
          "label": "Face denoise",
          "name": "face_denoise",
          "section": "Faces",
          "targets": [
            "face_pass.denoise"
          ]
        },
        {
          "label": "Eyes query",
          "name": "eyes_query",
          "section": "Eyes",
          "targets": [
            "find_eyes.query"
          ]
        },
        {
          "label": "Eyes denoise",
          "name": "eyes_denoise",
          "section": "Eyes",
          "targets": [
            "eyes_pass.denoise"
          ]
        }
      ],
      "name": "Face and eye detailer",
      "nodes": {
        "eyes_pass": {
          "inputs": {
            "boxes": {
              "from": "find_eyes.boxes"
            },
            "denoise": 0.35,
            "feather": 24,
            "guidance": 1,
            "image": {
              "from": "face_pass.image"
            },
            "padding": 8,
            "sampler": "euler",
            "scheduler": "simple",
            "seed": 776,
            "steps": 4,
            "target_size": 1024
          },
          "type": "fugue/detail-regions",
          "version": "1.0.0"
        },
        "face_pass": {
          "inputs": {
            "boxes": {
              "from": "find_face.boxes"
            },
            "denoise": 0.3,
            "feather": 24,
            "guidance": 1,
            "padding": 32,
            "sampler": "euler",
            "scheduler": "simple",
            "seed": 776,
            "steps": 4,
            "target_size": 1024
          },
          "type": "fugue/detail-regions",
          "version": "1.0.0"
        },
        "find_eyes": {
          "inputs": {
            "query": "eyes"
          },
          "type": "io.github.bmaltais.fugue-segment/find-by-text",
          "version": "1.0.0"
        },
        "find_face": {
          "inputs": {
            "query": "face"
          },
          "type": "io.github.bmaltais.fugue-segment/find-by-text",
          "version": "1.0.0"
        }
      },
      "outputs": [
        {
          "from": "eyes_pass.image",
          "label": "Image",
          "name": "image"
        }
      ],
      "version": "1.0.0"
    }
  },
  "layout": {
    "groups": {
      "local/face-and-eye-detailer": {
        "nodes": {
          "eyes_pass": {
            "pos": [
              680,
              0
            ]
          },
          "face_pass": {
            "pos": [
              340,
              0
            ]
          },
          "find_eyes": {
            "pos": [
              0,
              360
            ]
          },
          "find_face": {
            "pos": [
              0,
              0
            ]
          }
        }
      }
    },
    "nodes": {
      "compare": {
        "pos": [
          1020,
          0
        ]
      },
      "detail": {
        "pos": [
          680,
          0
        ]
      },
      "encode": {
        "pos": [
          340,
          0
        ]
      },
      "load": {
        "pos": [
          0,
          360
        ]
      },
      "models": {
        "pos": [
          0,
          0
        ]
      },
      "save": {
        "pos": [
          1020,
          560
        ]
      }
    }
  },
  "requires": {
    "fugue": "0.1.0",
    "models": [
      {
        "hash": "sha256:0cfbf745760f07a76ddeb358dd025a27f2e11d1ca9c9a4169a373d52990fe86e",
        "name": "Qwen3-8B-Q8_0.gguf",
        "resource": "fugue/text-encoder",
        "size": 8709519168,
        "source": "https://huggingface.co/unsloth/Qwen3-8B-GGUF/resolve/main/Qwen3-8B-Q8_0.gguf"
      },
      {
        "hash": "sha256:68957129335ce59ddadcb771f9c375f0ceb587b9c03a104e427fe303d3aab4c6",
        "name": "flux-2-klein-9b-Q8_0.gguf",
        "resource": "fugue/diffusion-model",
        "size": 10245691680,
        "source": "https://huggingface.co/unsloth/FLUX.2-klein-9B-GGUF/resolve/main/flux-2-klein-9b-Q8_0.gguf"
      },
      {
        "hash": "sha256:d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
        "name": "flux2-vae.safetensors",
        "resource": "fugue/vae",
        "size": 336213556,
        "source": "https://huggingface.co/Comfy-Org/Flux-2-Dev/resolve/main/split_files/vae/flux2-vae.safetensors"
      },
      {
        "hash": "sha256:04c18d2db35569f11c47732f2e05ed3a71559a8903823fc581e90b0e3168c9ff",
        "name": "grounding-dino-tiny_fp16.onnx",
        "resource": "io.github.bmaltais.fugue-segment/grounding-dino-model",
        "size": 360393267,
        "source": "https://huggingface.co/onnx-community/grounding-dino-tiny-ONNX/resolve/ff690b0a8050566c290287545bd059350f3e9096/onnx/model_fp16.onnx"
      }
    ],
    "packs": {
      "io.github.bmaltais.fugue-segment": {
        "version": "1.1.0"
      }
    }
  }
}
